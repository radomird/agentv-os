#!/bin/bash

# agentv:summary=Set the desktop account's password the TV was given
# agentv:hidden=true
# agentv:requires-sudo=true

# Settings → Omarchy desktop sets the password of the account the USB stick's
# first screen made, typed on the phone. AgenTV's daemon hands it over on a
# socket only it can reach (agentv-password.socket), and systemd starts this
# as root with that connection as stdin and stdout. It reads one line of
# JSON, {"password": "...", "grant": "..."}, and answers with one line,
# {"ok": true} or {"ok": false, "error": "..."}.
#
# The password goes from the socket to chpasswd's stdin and nowhere else:
# never on a command line, in a log or in a file. Once it's set, the account
# note says a password is known, and SSH takes passwords again, as Omarchy
# has it (install/tv/account.sh).

set -euo pipefail

MARKER=${AGENTV_ACCOUNT_MARKER:-/var/lib/agentv/account.json}
NO_PASSWORD=${AGENTV_SSHD_NO_PASSWORD:-/etc/ssh/sshd_config.d/05-agentv-no-password.conf}
url="http://127.0.0.1:${AGENTV_PORT:-3000}"

answer() {
  if [[ -z $1 ]]; then
    echo '{"ok":true}'
  else
    jq -nc --arg error "$1" '{ok: false, error: $error}'
    echo "agentv-password-set: $1" >&2
  fi
}

# One line, 4 KiB at most. Nothing longer is a password the TV sent.
line=""
IFS= read -r -n 4096 line || true
from_line() {
  printf '%s' "$line" | jq -r "$1" 2>/dev/null || true
}

# What's wrong with the password, if anything, before it's read out.
why=$(from_line '
  if type != "object" or (.password | type) != "string" then "no password came"
  elif (.password | length) < 8 then "the password needs 8 characters or more"
  elif (.password | length) > 128 then "the password can be 128 characters at most"
  elif (.password | explode | any(. < 32 or . == 127)) then "the password can'"'"'t have a line break in it"
  else "" end')
[[ -n $line ]] || why="no password came"

if [[ ! -f $MARKER ]]; then
  answer "this box's password is the one typed when it was installed"
  exit 0
fi
name=$(jq -r 'if type == "object" and (.name | type) == "string" then .name else empty end' "$MARKER" 2>/dev/null || true)
if [[ ! $name =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || ! uid=$(id -u "$name" 2>/dev/null) || (( uid < 1000 )); then
  answer "the account note doesn't name a person's account"
  exit 0
fi
if [[ -n $why ]]; then
  answer "$why"
  exit 0
fi

# The adult PIN, checked again here with the daemon, so only a request the
# TV allowed sets it. Neither the grant nor the password goes on a command
# line.
pin_allows() {
  local status
  status=$(curl -fsS --max-time 5 "$url/api/pin" 2>/dev/null) || return 1
  [[ $(printf '%s' "$status" | jq -r '.set' 2>/dev/null) == "true" ]] || return 0
  [[ $(from_line '{grant: (.grant // "")}' | curl -sS --max-time 10 -H 'Content-Type: application/json' --data-binary @- "$url/api/pin/allows" 2>/dev/null | jq -r '.ok // false' 2>/dev/null) == "true" ]]
}
if ! pin_allows; then
  answer "that needs the pin"
  exit 0
fi

# chpasswd reads "name:password" on stdin, and the password goes from the
# JSON straight into that line.
if ! { printf '%s:' "$name"; from_line '.password'; } | chpasswd >/dev/null 2>&1; then
  answer "the password didn't take"
  exit 0
fi

next=$(mktemp "$MARKER.XXXXXX")
jq '.passwordKnown = true' "$MARKER" >"$next"
chmod 644 "$next"
mv -f "$next" "$MARKER"

echo "agentv-password-set: $name's password is set, and SSH takes passwords again" >&2
if [[ -e $NO_PASSWORD ]]; then
  rm -f "$NO_PASSWORD"
  systemctl try-reload-or-restart sshd.service >/dev/null 2>&1 || true
fi
answer ""
