#!/bin/bash

# origaitv:summary=Hand a newly installed box over to TV setup
# origaitv:hidden=true
# origaitv:requires-sudo=true

# Runs once, as root, from origaitv-firstboot.service, before the login screen.
# Each leaf in install/tv/ runs through Omarchy's own run_logged, the way
# Omarchy runs its install leaves, and logs to /var/log/origaitv-firstboot.log.

set -euo pipefail

export OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
export ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}
export ORIGAITV_INSTALL="$ORIGAITV_PATH/install/tv"
export OMARCHY_INSTALL_LOG_FILE=/var/log/origaitv-firstboot.log

# The person who answered Omarchy's installer: the first ordinary user.
ORIGAITV_OWNER=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ { print $1; exit }' /etc/passwd)
if [[ -z $ORIGAITV_OWNER ]]; then
  echo "origaitv-firstboot: no user yet; trying again next boot" >&2
  exit 0
fi
ORIGAITV_OWNER_HOME=$(getent passwd "$ORIGAITV_OWNER" | cut -d: -f6)
export ORIGAITV_OWNER ORIGAITV_OWNER_HOME

# shellcheck source=/dev/null
source "$OMARCHY_PATH/install/helpers/logging.sh"
start_install_log

run_logged "$ORIGAITV_INSTALL/pacman.sh"
run_logged "$ORIGAITV_INSTALL/state.sh"
run_logged "$ORIGAITV_INSTALL/account.sh"
run_logged "$ORIGAITV_INSTALL/firewall.sh"
run_logged "$ORIGAITV_INSTALL/services.sh"
run_logged "$ORIGAITV_INSTALL/hooks.sh"
run_logged "$ORIGAITV_INSTALL/theme.sh"
run_logged "$ORIGAITV_INSTALL/notices.sh"
run_logged "$ORIGAITV_INSTALL/idle.sh"
run_logged "$ORIGAITV_INSTALL/audio.sh"
run_logged "$ORIGAITV_INSTALL/autologin.sh"
run_logged "$ORIGAITV_INSTALL/desktop.sh"
# A boot menu or a splash that fails to set isn't worth keeping the TV from
# starting.
run_logged "$ORIGAITV_INSTALL/bootmenu.sh" || echo "origaitv-firstboot: boot menu failed; see $OMARCHY_INSTALL_LOG_FILE" >&2
run_logged "$ORIGAITV_INSTALL/branding.sh" || echo "origaitv-firstboot: branding failed; see $OMARCHY_INSTALL_LOG_FILE" >&2

stop_install_log
touch /var/lib/origaitv/firstboot.done
