#!/bin/bash

# origaitv:summary=Install the official apps picked in TV setup
# origaitv:hidden=true
# origaitv:requires-sudo=true

# TV setup's apps (board 09), and the ones added from Apps after it
# (ADR-042). The TV hands the official apps picked to OrigaiTV's daemon, which
# can't write the apps folder. It leaves their ids in its own private state,
# and origaitv-setup-apps.path starts this as root to install each one with
# `origaitv app install`, from the signed index, one after the other. A native
# app's program comes with it, from origaitv-app-package@<app-id>.service,
# since this one can't write the system. /run/origaitv-setup-apps/state.json
# says how each is going, for the TV: queued, installing, installed or
# failed, with why.
#
# It's a queue (ADR-103): while it installs, the daemon can leave more, and
# it takes each new hand-over once it's done with the one before, until none
# is left. Each step has a time limit of its own, so a queue of every game
# platform can take as long as it needs, and one step that hangs ends
# without holding up the rest. A hand-over can also name official apps to remove, which takes
# the app off the TV and leaves its program, its games and its saves where
# they are, and the Xbox controller driver from Settings, Phones and
# controllers, which origaitv-xbox-driver.service installs. The removals go
# first, then the apps, then the driver, one at a time, so pacman is never
# asked twice at once.

# shellcheck disable=SC2016 # the single quotes hold jq's own filters
set -euo pipefail

DROP=${ORIGAITV_SETUP_APPS_DROP:-/var/lib/origaitv/daemon/apps-drop/install.json}
STATUS=${ORIGAITV_SETUP_APPS_STATUS:-/run/origaitv-setup-apps/state.json}
INSTALL=${ORIGAITV_APP_INSTALL:-origaitv-app-install}
REMOVE=${ORIGAITV_APP_REMOVE:-origaitv-app-remove}
APPS=${ORIGAITV_APPS:-/var/lib/origaitv/apps}
PACKAGE=${ORIGAITV_APP_PACKAGE:-}
DRIVER=${ORIGAITV_XBOX_DRIVER:-}
PACKAGE_ERRORS=${ORIGAITV_APP_PACKAGE_ERRORS:-/run/origaitv-app-package}
# How long fetching one app, or taking one off, may take. A program has its
# unit's own limit, and so does the driver.
INSTALL_LIMIT=${ORIGAITV_APP_INSTALL_LIMIT:-20m}
REMOVE_LIMIT=${ORIGAITV_APP_REMOVE_LIMIT:-10m}
ID='^[a-z0-9][a-z0-9-]*(\.[a-z0-9][a-z0-9-]*)+$'

[[ -f $DROP ]] || exit 0

install -d -m 755 "$(dirname -- "$STATUS")"
[[ -f $STATUS ]] && jq -e '.apps | type == "object"' "$STATUS" >/dev/null 2>&1 || echo '{"apps":{}}' >"$STATUS"

# write <jq filter> [jq args]: the status file, changed in one step.
write() {
  local next="$STATUS.next" filter=$1
  shift
  jq "$@" --arg at "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" "$filter | .at = \$at" "$STATUS" >"$next"
  chmod 644 "$next"
  mv -f "$next" "$STATUS"
}

# set_state <id> <state> [why]: one app's line in the status file.
set_state() {
  write '.apps[$id] = ({state: $state, at: $at} + (if $error == "" then {} else {error: $error} end))' --arg id "$1" --arg state "$2" --arg error "${3:-}"
}

# driver_state <state> [why] [restart]: the Xbox controller driver's line.
driver_state() {
  write '.drivers.xpadneo = ({state: $state, at: $at} + (if $error == "" then {} else {error: $error} end) + (if $restart == "yes" then {restart: true} else {} end))' \
    --arg state "$1" --arg error "${2:-}" --arg restart "${3:-}"
}

official() {
  [[ $(jq -r --arg id "$1" '.[$id].tier // empty' "$APPS/installed.json" 2>/dev/null) == "official" ]]
}

# needs_program <id>: whether an app that just installed is an official
# native app. Its program comes with it, and so do the first steps of a
# game platform (ADR-103), even when the program was there already:
# origaitv-app-package installs only what's missing.
needs_program() {
  official "$1" || return 1
  [[ $(jq -r '.tv.runtime // empty' "$APPS/$1/manifest.json" 2>/dev/null) == "native" ]]
}

# install_program <id>: the app's program, as root, in its own unit.
install_program() {
  if [[ -n $PACKAGE ]]; then
    "$PACKAGE" "$1"
  else
    systemctl start "origaitv-app-package@$1.service"
  fi
}

# install_app <id>
install_app() {
  local id=$1 out why status=0
  set_state "$id" installing
  out=$(timeout --kill-after=1m "$INSTALL_LIMIT" "$INSTALL" "$id" 2>&1) || status=$?
  if (( status == 0 )); then
    echo "origaitv-setup-apps: installed $id"
    if needs_program "$id"; then
      echo "origaitv-setup-apps: installing the program $id opens"
      if ! install_program "$id"; then
        why=$(head -n 1 "$PACKAGE_ERRORS/$id.error" 2>/dev/null | cut -c1-200 || true)
        [[ -n $why ]] || why="Couldn't install it"
        set_state "$id" failed "$why"
        echo "origaitv-setup-apps: the program $id opens didn't install: $why" >&2
        return
      fi
    fi
    set_state "$id" installed
  elif (( status == 124 || status == 137 )); then
    why="It took too long. Try again later."
    set_state "$id" failed "$why"
    echo "origaitv-setup-apps: $id didn't install within $INSTALL_LIMIT" >&2
  else
    # The installer's own last line says why. A lone sentence loses its
    # full stop, as a notice on the TV has none.
    why=$(printf '%s\n' "$out" | grep -v '^\s*$' | tail -n 1 | sed -E 's/^(Couldn.t do it|Something went wrong): //' | cut -c1-200)
    [[ $why == *". "* ]] || why=${why%.}
    [[ -n $why ]] || why="Couldn't install it"
    set_state "$id" failed "$why"
    echo "origaitv-setup-apps: $id didn't install: $why" >&2
  fi
}

# remove_app <id>: an official app off the TV. Its program stays, with its
# games and saves: Omarchy's own remove scripts would delete those, so none
# of them runs here.
remove_app() {
  local id=$1
  if ! official "$id"; then
    echo "origaitv-setup-apps: $id isn't an official app on this TV; left as it is" >&2
    write 'del(.apps[$id])' --arg id "$id"
    return
  fi
  set_state "$id" removing
  if timeout --kill-after=1m "$REMOVE_LIMIT" "$REMOVE" "$id" >/dev/null 2>&1; then
    write 'del(.apps[$id])' --arg id "$id"
    echo "origaitv-setup-apps: removed $id, and left its program and its saves"
  else
    set_state "$id" installed "Couldn't remove it"
    echo "origaitv-setup-apps: $id wasn't removed" >&2
  fi
}

# install_driver: the Xbox controller driver, in its own unit.
install_driver() {
  local why restart=""
  driver_state installing
  if if [[ -n $DRIVER ]]; then "$DRIVER"; else systemctl start origaitv-xbox-driver.service; fi; then
    [[ -f $PACKAGE_ERRORS/xpadneo.restart ]] && restart=yes
    driver_state installed "" "$restart"
    echo "origaitv-setup-apps: the Xbox controller driver is in"
  else
    why=$(head -n 1 "$PACKAGE_ERRORS/xpadneo.error" 2>/dev/null | cut -c1-200 || true)
    [[ -n $why ]] || why="Couldn't install the driver"
    driver_state failed "$why"
    echo "origaitv-setup-apps: the Xbox controller driver didn't install: $why" >&2
  fi
}

# Each hand-over, until the daemon has left no more.
while [[ -f $DROP ]]; do
  # Taken aside first, then read. A hand-over the daemon leaves meanwhile is
  # a new file in its place, taken on the next turn, never lost.
  taken="$DROP.taken"
  # The folder is the daemon's, so root follows no link in it. One where the
  # hand-over is taken aside would move it into the folder the link names,
  # and -T keeps mv from doing that if one turns up after this look.
  if [[ -L $DROP || -L $taken ]]; then
    echo "origaitv-setup-apps: a link in the hand-over's folder; nothing taken" >&2
    exit 1
  fi
  mv -fT "$DROP" "$taken" || break
  if [[ -L $taken ]]; then
    rm -f "$taken"
    echo "origaitv-setup-apps: the hand-over was a link; nothing taken" >&2
    exit 1
  fi
  mapfile -t apps < <(jq -r '.apps[]? | strings' "$taken" 2>/dev/null || true)
  mapfile -t gone < <(jq -r '.remove[]? | strings' "$taken" 2>/dev/null || true)
  driver=$(jq -r 'if .driver == "xpadneo" then "xpadneo" else empty end' "$taken" 2>/dev/null || true)

  wanted=()
  for id in "${apps[@]}"; do
    if [[ ! $id =~ $ID ]]; then
      echo "origaitv-setup-apps: '$id' isn't an app id; left out" >&2
      continue
    fi
    wanted+=("$id")
    set_state "$id" queued
  done
  removing=()
  for id in "${gone[@]}"; do
    [[ $id =~ $ID ]] || continue
    removing+=("$id")
    set_state "$id" removing
  done
  [[ -z $driver ]] || driver_state queued
  # Each one marked first: until then, the daemon counts the hand-over
  # taken aside as still waiting.
  rm -f "$taken"

  for id in "${removing[@]}"; do remove_app "$id"; done
  for id in "${wanted[@]}"; do install_app "$id"; done
  [[ -z $driver ]] || install_driver
done
