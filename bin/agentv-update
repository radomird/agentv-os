#!/bin/bash

# agentv:summary=Update AgenTV, Omarchy and the system packages in place
# agentv:args=[-y] [--untested]
# agentv:examples=agentv update | agentv update -y
# agentv:requires-sudo=true

# AgenTV ships as its own package beside Omarchy's (ADR-025), so Omarchy's own
# update moves both: one snapshot, one pacman -Syu for Arch, Omarchy and
# AgenTV, then Omarchy's migrations and its post-update hook, where AgenTV's
# own migrations run (config/omarchy/hooks/post-update.d/agentv).

set -euo pipefail

AGENTV_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

untested=0
yes=0
args=()
for arg in "$@"; do
  case "$arg" in
    --untested) untested=1 ;;
    -y) yes=1 ;;
    *) args+=("$arg") ;;
  esac
done

# Omarchy writes /etc/pacman.conf from its own template, which doesn't know
# about AgenTV's repository. Put it back first, or AgenTV never updates.
sudo "$AGENTV_BIN_DIR/agentv-pacman-conf"

# Only versions AgenTV's nightly run has passed (ADR-026). That run tests the
# release, so it holds back stable. edge takes every green build of agentv-os
# (ADR-025), newer than any night's, so it skips the check, and so does
# --untested.
if [[ $("$AGENTV_BIN_DIR/agentv-channel") == "edge" ]]; then
  echo "On edge: taking AgenTV's newest green build, without waiting for the nightly run."
elif (( ! untested )); then
  "$AGENTV_BIN_DIR/agentv-tested" || exit 1
fi

# AgenTV asks its own question, with AgenTV's versions and release notes
# (ADR-029), so Omarchy's update runs with -y and skips its own.
if (( ! yes )); then
  "$AGENTV_BIN_DIR/agentv-update-confirm" || exit 1
fi

exec omarchy-update -y ${args[@]+"${args[@]}"}
