#!/bin/bash

# origaitv:summary=Print the installed origaiTV and Omarchy versions
# origaitv:examples=origaitv version

set -euo pipefail

ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}

if [[ -f $ORIGAITV_PATH/settings ]]; then
  # shellcheck source=/dev/null
  source "$ORIGAITV_PATH/settings"
  echo "origaiTV ${ORIGAITV_VERSION:-unknown} (${ORIGAITV_CHANNEL:-stable})"
else
  # A checkout, not the package.
  echo "origaiTV dev ($(git -C "$ORIGAITV_PATH" rev-parse --short HEAD 2>/dev/null || echo unknown))"
fi

if type -P omarchy-version >/dev/null; then
  echo "Omarchy $(omarchy-version)"
fi
