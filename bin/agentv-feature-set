#!/bin/bash

# agentv:summary=Turn a feature switch on or off
# agentv:args=<name> <on|off>
# agentv:hidden=true

# What agentv feature on and off run. The daemon keeps the switch, and only
# an edge box can turn one on.

set -euo pipefail

if (( $# != 2 )) || [[ ! $1 =~ ^[a-z0-9]+$ ]] || [[ $2 != on && $2 != off ]]; then
  echo "Usage: agentv feature on <name>, or agentv feature off <name>. agentv feature list has the names." >&2
  exit 2
fi
name=$1
word=$2
on=$([[ $word == on ]] && echo true || echo false)

port=${AGENTV_PORT:-3000}
status=0
answer=$(curl -sS --max-time 5 -w '\n%{http_code}' -X PUT -H 'Content-Type: application/json' \
  -d "{\"$name\": $on}" "http://127.0.0.1:$port/api/features" 2>/dev/null) || status=$?
code=${answer##*$'\n'}
answer=${answer%$'\n'*}
if (( status != 0 )) || [[ $code == 000 ]]; then
  echo "AgenTV's daemon isn't answering. Try: sudo systemctl restart agentv-daemon" >&2
  exit 1
fi
if [[ $code != 200 ]]; then
  jq -r '.error // "That didn'"'"'t work."' <<<"$answer" >&2 2>/dev/null || echo "That didn't work." >&2
  exit 1
fi
echo "$name is $word."
