#!/bin/bash

# agentv:summary=Run AgenTV's fast gate (ADR-019 layer 1) on this repo
# agentv:args=[--ci] [--fetch-base]
# agentv:examples=agentv check | agentv check --ci --fetch-base
# agentv:hidden=true

# The same file lives in agentv-os, agentv-iso and agentv-apps. Keep the
# copies identical. It runs on the Mac's bash 3.2 as well, so it can be the
# gate before every commit there: no mapfile, namerefs or associative arrays.

set -euo pipefail

usage() {
  cat <<USAGE
Usage: agentv-check [--ci] [--fetch-base]

Checks that Omarchy's files are untouched, and that everything AgenTV added
has no em dashes, no secrets, no service automation, no emoji in UI text,
UI text in AgenTV's voice and clean shell. Exits non-zero if anything fails.

  --ci          Treat a missing tool (shellcheck, gitleaks) as a failure
  --fetch-base  Fetch the base from upstream when this clone doesn't have it
USAGE
}

ci=0
fetch_base=0
while (( $# )); do
  case "$1" in
    --ci) ci=1 ;;
    --fetch-base) fetch_base=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

POLICY_DIR=test/agentv/policy
EM_DASH=$'\xe2\x80\x94'
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

failures=0

pass() {
  printf 'ok - %s\n' "$1"
}

fail() {
  local description="$1"
  local detail="${2:-}"

  [[ -n $detail ]] && printf '%s\n' "$detail" | sed 's/^/    /' >&2
  printf 'not ok - %s\n' "$description" >&2
  failures=$(( failures + 1 ))
}

skip() {
  if (( ci )); then
    fail "$1" "$2 is not installed"
  else
    printf 'skip - %s (%s is not installed)\n' "$1" "$2"
  fi
}

have() {
  type -P "$1" >/dev/null
}

# Lines of a policy file, without comments and blank lines.
policy_lines() {
  [[ -f $POLICY_DIR/$1 ]] || return 0
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$POLICY_DIR/$1"
}

# --- The base: the upstream tag or commit this fork sits on -----------------

# A repo of AgenTV's own, such as agentv-pkgs, has no base: every file in it
# is AgenTV's, and every commit.
if [[ ! -f .github/omarchy-base ]]; then
  base_commit=$(git hash-object -t tree /dev/null)
  log_range=HEAD
  pass "not a fork, so every file is AgenTV's"
else
  base=$(sed -n '1{s/[[:space:]]//g;p;}' .github/omarchy-base)
  upstream=$(sed -n '1{s/[[:space:]]//g;p;}' .github/omarchy-upstream)

  if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null && (( fetch_base )); then
    if [[ $base == v* ]]; then
      git fetch --quiet --no-tags "https://github.com/$upstream.git" "+refs/tags/$base:refs/tags/$base"
    else
      git fetch --quiet --no-tags "https://github.com/$upstream.git" "$base"
    fi
  fi

  if ! base_commit=$(git rev-parse --verify --quiet "$base^{commit}"); then
    fail "the Omarchy base $base is in this clone" "run agentv-check --fetch-base, or fetch it from upstream"
    exit 1
  fi
  log_range="$base_commit..HEAD"

  # The commits that are AgenTV's: not the base's, and not those of any base
  # the fork sat on before. When Omarchy cuts a release beside the line the
  # fork was on, as it did 4.5 beside 4.0.x, the old line's own commits are
  # still in agentv's history but not in the new base's.
  while IFS= read -r commit; do
    old=$(git show "$commit:.github/omarchy-base" 2>/dev/null | sed -n '1{s/[[:space:]]//g;p;}')
    [[ -n $old && $old != "$base" ]] || continue
    if ! git rev-parse --verify --quiet "$old^{commit}" >/dev/null && (( fetch_base )); then
      if [[ $old == v* ]]; then
        git fetch --quiet --no-tags "https://github.com/$upstream.git" "+refs/tags/$old:refs/tags/$old" || true
      else
        git fetch --quiet --no-tags "https://github.com/$upstream.git" "$old" || true
      fi
    fi
    if old_commit=$(git rev-parse --verify --quiet "$old^{commit}"); then
      log_range+=" ^$old_commit"
    else
      fail "the earlier Omarchy base $old is in this clone" "run agentv-check --fetch-base, or fetch it from upstream"
    fi
  done < <(git log --format=%H -- .github/omarchy-base)
  pass "the Omarchy base is $base"

  # --- Omarchy's files are untouched ----------------------------------------

  # Against the working tree, so a change that isn't committed yet counts too.
  # --no-renames turns a rename into a deletion plus an addition, and it saves
  # a blobless clone from fetching file contents to compare.
  policy_lines upstream-exceptions >"$WORK/exceptions"
  git diff --no-renames --name-only --diff-filter=MDT "$base_commit" |
    grep -vxF -f "$WORK/exceptions" >"$WORK/changed" || true

  if [[ -s $WORK/changed ]]; then
    fail "Omarchy's files are unchanged since $base" "$(cat "$WORK/changed")"
  else
    pass "Omarchy's files are unchanged since $base"
  fi
fi

# --- What AgenTV added ------------------------------------------------------

# -z, so git hands over every name exactly as it is. Without it, git quotes a
# name with unusual characters, and that file would slip past every scan.
{
  git diff -z --no-renames --name-only --diff-filter=A "$base_commit"
  git ls-files -z --others --exclude-standard
} >"$WORK/all-added.z"

# Below, the lists hold one name per line, so a name with a newline or another
# control character in it can't be listed. It fails the gate instead.
# shellcheck disable=SC2016 # the single quotes hold perl, not shell
perl -0 -ne 'chomp; print "$_\n" if /[\x00-\x1f\x7f]/' "$WORK/all-added.z" >"$WORK/odd-names"
if [[ -s $WORK/odd-names ]]; then
  fail "file names have no control characters" "$(cat -v "$WORK/odd-names")"
fi
# shellcheck disable=SC2016 # the single quotes hold perl, not shell
perl -0 -ne 'chomp; print "$_\n" unless /[\x00-\x1f\x7f]/' "$WORK/all-added.z" | sort -u >"$WORK/all-added"

# Regular text files only: no symlinks, no images, nothing empty. The -- keeps
# a name that starts with a dash from passing for an option.
: >"$WORK/ours"
while IFS= read -r file; do
  [[ -f $file && ! -L $file ]] || continue
  grep -Iq -e . -- "$file" 2>/dev/null || continue
  printf '%s\n' "$file" >>"$WORK/ours"
done <"$WORK/all-added"

# The policy files hold the very patterns the scans look for.
grep -v "^$POLICY_DIR/" "$WORK/ours" >"$WORK/scanned" || true

added_count=$(grep -c . "$WORK/all-added" || true)
pass "AgenTV added $added_count files"

# Prints file:line for every line of the listed files that matches the perl
# pattern. The pattern sees decoded UTF-8 when the second argument is "utf8".
#
# The names come in on stdin and each file is opened with a three-argument
# open. perl -n over @ARGV would open them the two-argument way, where a name
# like "x|cmd|" runs cmd: anyone who can add a file to a pull request could run
# a command in CI. The pattern travels in the environment, so a slash in it
# can't end the regex early. A scan that breaks reports itself rather than
# finding nothing.
scan() {
  local pattern="$1" mode="${2:-bytes}" list="$3"

  [[ -s $list ]] || return 0
  # shellcheck disable=SC2016 # the single quotes hold perl, not shell
  AGENTV_PATTERN="$pattern" AGENTV_MODE="$mode" perl -e '
    my $re = qr/$ENV{AGENTV_PATTERN}/;
    my $layer = $ENV{AGENTV_MODE} eq "utf8" ? "<:encoding(UTF-8)" : "<:raw";
    my $failed = 0;
    while (my $file = <STDIN>) {
      chomp $file;
      open(my $fh, $layer, $file) or do { warn "cannot read $file: $!\n"; $failed = 1; next };
      while (my $line = <$fh>) {
        print "$file:$.\n" if $line =~ $re;
      }
      close $fh;
    }
    exit $failed;
  ' <"$list" || echo "(the scan for $pattern failed)"
}

# --- No em dashes, in files or commit messages ------------------------------

found=$(scan "$EM_DASH" bytes "$WORK/ours")
# shellcheck disable=SC2086 # the range is a list of revisions
git log --format='%h %s%n%b' $log_range | grep -F "$EM_DASH" >"$WORK/dash-commits" || true
if [[ -n $found || -s $WORK/dash-commits ]]; then
  fail "no em dashes in what AgenTV added" "$(printf '%s\n%s' "$found" "$(cat "$WORK/dash-commits")" | sed '/^$/d')"
else
  pass "no em dashes in what AgenTV added"
fi

# --- No service automation in a public repo ---------------------------------

# The lists are refused in every file AgenTV added, with one exception. In
# agentv-apps, each official streaming app has a folder of its own, and
# service-folders says which. Inside its own folder an app may use the lines
# under its service's "#@ <id>" heading in the lists, and nothing else. No
# other repo has service-folders, so there the lists are refused everywhere.

# A list's patterns, one a line, each followed by a tab and the services it
# belongs to. "#@ <id> ..." starts a service's lines, and "#@" on its own
# ends them.
service_lines() {
  [[ -f $POLICY_DIR/$1 ]] || return 0
  # shellcheck disable=SC2016 # the single quotes hold perl, not shell
  perl -ne '
    if (/^\s*#@\s*(.*?)\s*$/) { $ids = $1; next }
    s/\s*#.*$//; s/\s+$//;
    print "$_\t$ids\n" if length;
  ' "$POLICY_DIR/$1"
}

# Each file of a list, after the service whose folder it's in, if any, and a
# tab. A folder always ends in a slash, so apps/tv/ never takes in
# apps/tv-old/.
by_service() {
  # shellcheck disable=SC2016 # the single quotes hold perl, not shell
  perl -e '
    my @folders;
    if (open(my $fh, "<", $ARGV[0])) {
      while (<$fh>) {
        s/\s*#.*$//;
        my ($id, $dir) = split;
        next unless defined $dir;
        $dir .= "/" unless $dir =~ m{/$};
        push @folders, [$id, $dir];
      }
    }
    while (my $file = <STDIN>) {
      chomp $file;
      my ($in) = grep { index($file, $_->[1]) == 0 } @folders;
      print(($in ? $in->[0] : ""), "\t$file\n");
    }
  ' "$POLICY_DIR/service-folders" <"$1"
}

# scan_lists <list> <files> <before> <after>: the files that use a pattern of
# the list, each file against every pattern but its own service's. The
# patterns go between before and after.
scan_lists() {
  local list="$1" files="$2" before="$3" after="$4" id patterns

  [[ -s $list && -s $files ]] || return 0
  by_service "$files" >"$WORK/by-service"
  cut -f1 "$WORK/by-service" | sort -u >"$WORK/services"
  while IFS= read -r id; do
    awk -F '\t' -v id="$id" '$1 == id { print $2 }' "$WORK/by-service" >"$WORK/these"
    patterns=$(awk -F '\t' -v id="$id" '{
      n = split($2, ids, " ")
      for (i = 1; i <= n; i++) if (ids[i] == id) next
      print $1
    }' "$list" | paste -sd '|' -)
    if [[ -n $patterns ]]; then
      scan "$before$patterns$after" bytes "$WORK/these"
    fi
  done <"$WORK/services"
}

service_lines service-hosts >"$WORK/hosts"
found=$(scan_lists "$WORK/hosts" "$WORK/scanned" "(?i)(?:" ")")

# Brand names count in code and config, not in prose.
grep -vE '\.(md|txt)$|(^|/)LICENSE[^/]*$' "$WORK/scanned" >"$WORK/code" || true
service_lines service-names >"$WORK/names"
found=$(printf '%s\n%s' "$found" "$(scan_lists "$WORK/names" "$WORK/code" "(?i)\\b(?:" ")\\b")" | sed '/^$/d')

if [[ -n $found ]]; then
  fail "no service automation in a public repo" "$found"
else
  pass "no service automation in a public repo"
fi

# --- No GitHub owner in code ------------------------------------------------

owner=$(git config --get remote.origin.url 2>/dev/null | sed -nE 's#.*github\.com[:/]([^/]+)/.*#\1#p')
if [[ -n $owner ]]; then
  policy_lines owner-allowed >"$WORK/owner-allowed"
  grep -vxF -f "$WORK/owner-allowed" "$WORK/code" >"$WORK/owner-scanned" || true
  found=$(scan "(?i)\\b$owner\\b" bytes "$WORK/owner-scanned")
  if [[ -n $found ]]; then
    fail "the GitHub owner ($owner) lives in one setting, not in code" "$found"
  else
    pass "the GitHub owner lives in one setting, not in code"
  fi
fi

# --- No emoji in UI text ----------------------------------------------------

grep -E '^(launcher|setup|companion-web|apps)/' "$WORK/scanned" >"$WORK/ui" || true
found=$(scan '\p{Emoji_Presentation}|\x{FE0F}' utf8 "$WORK/ui")
if [[ -n $found ]]; then
  fail "no emoji in UI text" "$found"
else
  pass "no emoji in UI text"
fi

# --- UI text in AgenTV's voice ---------------------------------------------

# The words people read on the TV, the phone and the USB stick follow
# AgenTV's voice (the agentv-copy skill). The parts of it a machine can check
# are here: none of the words that name how the TV works, and no key in a
# button's words. ui-text lists the files with words people read, ui-words
# the words they never say, and ui-words-allowed the few places one is right.
# A repo without ui-text has no UI, and skips this.
if [[ -f $POLICY_DIR/ui-text ]]; then
  policy_lines ui-text >"$WORK/ui-text"
  policy_lines ui-words >"$WORK/ui-words"
  policy_lines ui-words-allowed >"$WORK/ui-allowed"
  # shellcheck disable=SC2016 # the single quotes hold perl, not shell
  found=$(perl -CSD -e '
    use strict; use warnings;
    my ($places, $words, $allowed) = @ARGV;
    my (@places, @words, @allowed);
    open(my $fh, "<:encoding(UTF-8)", $places) or die "$places: $!";
    while (<$fh>) { chomp; my ($prefix, $only) = /^(\S+)(?:\s+only:(.*))?$/ or next; push @places, [$prefix, $only] }
    open($fh, "<:encoding(UTF-8)", $words) or die "$words: $!";
    while (<$fh>) { chomp; push @words, qr/$_/i if length }
    if (open($fh, "<:encoding(UTF-8)", $allowed)) {
      while (<$fh>) { chomp; my ($prefix, $re) = /^(\S+)\s+(.*)$/ or next; push @allowed, [$prefix, qr/$re/i] }
    }
    my $literal = qr/"((?:[^"\\]|\\.)*)"|\x27((?:[^\x27\\]|\\.)*)\x27|`((?:[^`\\]|\\.)*)`/;
    my $failed = 0;
    while (my $file = <STDIN>) {
      chomp $file;
      my ($place) = grep { index($file, $_->[0]) == 0 } @places;
      next unless $place;
      # Test data and tests read words, they do not show them.
      next if $file =~ m{/(?:fixtures|tests?)/|\.test\.m?[jt]s$};
      my $only = defined $place->[1] ? qr/$place->[1]/ : undef;
      my $json = $file =~ /\.json$/;
      my $html = $file =~ /\.html?$/;
      open(my $in, "<:encoding(UTF-8)", $file) or do { warn "cannot read $file: $!\n"; $failed = 1; next };
      my $doc = 0;
      while (my $line = <$in>) {
        # A docstring is for whoever reads the code.
        my $quotes = () = $line =~ /"""|\x27\x27\x27/g;
        if ($doc || $quotes) { $doc = !$doc if $quotes % 2; next }
        # Comments (in Lua too, after two dashes), imports and what goes to a
        # log are for whoever reads the code.
        next if $line =~ m{^\s*(?://|/?\*|\#(?!\s*\S+\s*["\x27`])|<!--|--(?:\s|$)|import\s)};
        next if $line =~ /\bconsole\.\w+\(|\blog\(|\.debug\(|journal/;
        next if $only && $line !~ $only;
        # A class name, a data attribute, a test id and a regex are not
        # words anyone reads.
        $line =~ s/\b(?:class|id|for|key|action|kind|type)\s*[:=]\s*(?:"[^"]*"|`[^`]*`|\x27[^\x27]*\x27)//g;
        $line =~ s/"(?:data|aria-hidden)[\w-]*"\s*:\s*(?:"[^"]*"|`[^`]*`)//g;
        $line =~ s{(?:(?<=[(,=:\[|&!]\s)|(?<=[(,=:\[|&!]))/(?![/*\s])(?:[^/\\\n]|\\.)+/[dgimsuy]*}{ }g;
        my @text;
        if ($json) {
          push @text, $1 while $line =~ /"(?:name|description|label|title|line|note)"\s*:\s*"((?:[^"\\]|\\.)*)"/g;
        } else {
          while ($line =~ /$literal/g) { push @text, defined $1 ? $1 : defined $2 ? $2 : $3 }
          if ($html) { (my $bare = $line) =~ s/<[^>]*>/ /g; $bare =~ s/"[^"]*"//g; push @text, $bare if $bare =~ /\pL{3}/ }
        }
        for my $text (@text) {
          # An address, a path, a selector or a list of class names is not
          # something people read, even after a value: ${base}/api is a path,
          # and ${name} has no key is a sentence.
          next if $text =~ m~^\s*(?:\$\{[^\}]*\}\s*)*[/.\#\[@]|://|=>~;
          $text =~ s/\$\{[^}]*\}/ ... /g;
          next unless $text =~ /\pL/;
          next if $text !~ /\p{Lu}/ && $text =~ /\b\pL+-\pL/ && $text !~ /[\x27\x{2019}.,?!:]/;
          next unless $text =~ /\s/ || $text =~ /^\p{Lu}/;
          for my $word (@words) {
            next unless $text =~ $word;
            next if grep { index($file, $_->[0]) == 0 && $text =~ $_->[1] } @allowed;
            (my $shown = $text) =~ s/\s+/ /g;
            print "$file:$.: \"$shown\"\n";
            last;
          }
        }
      }
      close $in;
    }
    exit $failed;
  ' "$WORK/ui-text" "$WORK/ui-words" "$WORK/ui-allowed" <"$WORK/scanned" || echo "(the scan of UI text failed)")
  if [[ -n $found ]]; then
    fail "UI text is in AgenTV's voice" "$found"
  else
    pass "UI text is in AgenTV's voice"
  fi
else
  pass "no UI text here, so nothing to check for its voice"
fi

# --- App packages pass agentv app validate ----------------------------------

# Every app package in the repo, against the app contract (ADR-019). The
# built-ins and the apps in the test fixtures are AgenTV's own, so they're
# checked as official apps. A repo without the contract, such as agentv-iso,
# has none.
if [[ -f apps/contract/validate.ts ]]; then
  find apps test/agentv/fixtures/apps -mindepth 2 -maxdepth 3 -name manifest.json \
    -not -path 'apps/contract/*' 2>/dev/null | sort >"$WORK/manifests" || true
  if [[ ! -s $WORK/manifests ]]; then
    pass "app packages pass agentv app validate (none yet)"
  elif ! have node; then
    skip "app packages pass agentv app validate" node
  else
    packages=()
    while IFS= read -r manifest; do
      packages+=("$(dirname -- "$manifest")")
    done <"$WORK/manifests"
    if AGENTV_PATH="$ROOT" bin/agentv-app-validate --official "${packages[@]}" >"$WORK/apps.log" 2>&1; then
      pass "app packages pass agentv app validate (${#packages[@]} checked)"
    else
      fail "app packages pass agentv app validate" "$(cat "$WORK/apps.log")"
    fi
  fi
fi

# --- Omarchy's MIT attribution ----------------------------------------------

missing=""
grep -q "Permission is hereby granted, free of charge" LICENSE 2>/dev/null || missing+=$'LICENSE is not the MIT licence\n'
grep -qis 'Powered by.*Omarchy' .github/README.md README.md || missing+=$'the README does not say Powered by Omarchy\n'
if [[ -n $missing ]]; then
  fail "Omarchy's attribution is present" "$missing"
else
  pass "Omarchy's attribution is present"
fi

# --- Shell scripts pass shellcheck ------------------------------------------

# Sourced leaves and Omarchy hooks have no shebang, so they're named by place.
: >"$WORK/shell"
while IFS= read -r file; do
  first=$(head -n 1 -- "$file")
  if [[ $file == *.sh || $file == */PKGBUILD || $file == PKGBUILD || $first =~ ^#!.*(bash|/sh) ]]; then
    printf '%s\n' "$file" >>"$WORK/shell"
  elif [[ $file =~ ^(install/tv|migrations/agentv|config/omarchy/hooks)/ ]]; then
    printf '%s\n' "$file" >>"$WORK/shell"
  fi
done <"$WORK/ours"

if ! have shellcheck; then
  skip "shell scripts pass shellcheck" shellcheck
elif [[ ! -s $WORK/shell ]]; then
  pass "shell scripts pass shellcheck (none yet)"
else
  # SC1091: sourced files from Omarchy's package aren't in this tree.
  # PKGBUILDs set variables that makepkg reads.
  : >"$WORK/shellcheck.log"
  while IFS= read -r file; do
    args=(--shell=bash --exclude=SC1091)
    [[ $file == *PKGBUILD ]] && args+=("--exclude=SC2034,SC2154,SC2164")
    shellcheck "${args[@]}" -- "$file" >>"$WORK/shellcheck.log" 2>&1 || true
  done <"$WORK/shell"
  if [[ -s $WORK/shellcheck.log ]]; then
    fail "shell scripts pass shellcheck" "$(cat "$WORK/shellcheck.log")"
  else
    pass "shell scripts pass shellcheck ($(grep -c . "$WORK/shell") checked)"
  fi
fi

# --- No secrets -------------------------------------------------------------

if ! have gitleaks; then
  skip "no secrets" gitleaks
else
  # The files as they are now, committed or not, then every AgenTV commit, so
  # a secret that was added and later removed still counts.
  mkdir -p "$WORK/tree"
  while IFS= read -r file; do
    mkdir -p "$WORK/tree/$(dirname -- "$file")"
    cp -- "$file" "$WORK/tree/$file"
  done <"$WORK/ours"

  # A clone without file contents, as CI's checkout is, fetches each one
  # the first time it's read, so gitleaks would fetch them a commit at a
  # time. Fetch every version the AgenTV commits changed in one go first.
  if [[ $(git config --get remote.origin.promisor) == "true" ]]; then
    # shellcheck disable=SC2086 # the range is a list of revisions
    git log --no-merges --raw --no-abbrev --format= $log_range \
      | awk '$1 != ":160000" { print $3 } $2 != "160000" { print $4 }' \
      | grep -v '^0*$' | sort -u >"$WORK/blobs" || true
    if [[ -s $WORK/blobs ]]; then
      git -c fetch.negotiationAlgorithm=noop fetch --quiet --no-tags --no-write-fetch-head \
        --recurse-submodules=no --filter=blob:none --stdin origin <"$WORK/blobs" || true
    fi
  fi

  # -v prints each finding, redacted, so the log says where it is.
  leaked=0
  gitleaks dir --no-banner --no-color --redact -v --log-level warn "$WORK/tree" >"$WORK/leaks" 2>&1 || leaked=1
  gitleaks git --no-banner --no-color --redact -v --log-level warn \
    --log-opts="--no-merges $log_range" . >>"$WORK/leaks" 2>&1 || leaked=1
  if (( leaked )); then
    fail "no secrets" "$(sed "s#$WORK/tree/##" "$WORK/leaks")"
  else
    pass "no secrets"
  fi
fi

# --- Done -------------------------------------------------------------------

if (( failures > 0 )); then
  printf '\n%d check(s) failed.\n' "$failures" >&2
  exit 1
fi
printf '\nThe fast gate is green.\n'
