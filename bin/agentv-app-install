#!/bin/bash

# agentv:summary=Install an app from AgenTV's signed app index
# agentv:args=<app-id> [--index <folder-or-url>]
# agentv:requires-sudo=true

# Fetches the app's exact commit from the repo the signed index pins it to,
# checks it against the app contract and puts it in /var/lib/agentv/apps/.
# The index counts only with a good signature from AgenTV's key (ADR-010).

set -euo pipefail

AGENTV_PATH=${AGENTV_PATH:-/usr/share/agentv}
AGENTV_STATE=${AGENTV_STATE:-/var/lib/agentv}

# The apps belong to the box, so changing them takes sudo, in this terminal.
apps="$AGENTV_STATE/apps"
[[ -d $apps ]] || apps=$AGENTV_STATE
if [[ ! -w $apps ]] && (( EUID != 0 )); then
  exec sudo -- "$0" "$@"
fi

# Node 22.6 to 22.17 runs TypeScript only when asked.
flags=()
[[ -n $(node -p 'process.features.typescript || ""' 2>/dev/null) ]] || flags+=(--experimental-strip-types)

export AGENTV_PATH AGENTV_STATE
exec node ${flags[@]+"${flags[@]}"} --disable-warning=ExperimentalWarning "$AGENTV_PATH/daemon/apps/cli.ts" install "$@"
