#!/bin/bash

# agentv:summary=Check this box for the current stage's NUC checks and say pass or fail for each
# agentv:args=[S0.2|S0.3|S1.1|S1.2|S1.5|S1.6|S1.7|S2|S2.8|S2.9|S2.10|S2.11|S2.15|S2.16]...
# agentv:examples=agentv selftest | agentv selftest S2 | agentv selftest S1.5 | agentv selftest S0.2 S0.3
# agentv:requires-sudo=true

# The acceptance checks CI can't see, run on the box itself (ADR-019, layer
# 7). Every line starts with pass, fail or manual and the check's id, so the
# whole output can be pasted back as it is. With no id it runs stages 1
# and 2. Run them over SSH while the TV is on, as the person it logs in.
#
# Stage 1, the TV session (ADR-031):
#
#   S1.1  SDDM logs in to the TV session and back in after a log-out; the
#         home screen is in front; nothing of Omarchy's desktop runs there.
#   S1.2  the services' Chromium has its Widevine module. The 10 minutes of
#         playback and the fan are for eyes and ears: manual lines say so.
#   S1.5  how smoothly the home screen draws; an app in front and the home
#         screen back; a toast over the app; Steam in its own gamescope.
#         What only a person can judge is listed on manual lines.
#   S1.6  a new window stays out of sight, and the home screen comes back in
#         front after a crash. It closes the home screen on purpose for that.
#   S1.7  the services' Chromium has its own prompts off: saving passwords,
#         address and card autofill, translate, notifications (ADR-032).
#
# Stage 2, the home screen (S2 runs them all). Each also says, on manual
# lines, what to watch or listen for:
#
#   S2.8  the box reads the TV as on, and what it saw the last time the TV
#         went off and came back.
#   S2.9  a key reaches the home screen through the virtual input device.
#   S2.10 how smoothly the home screen draws while the focus glides, a tile
#         lifts under the mouse and a page slides in and out.
#   S2.11 how soon after its key each UI sound starts, and a held arrow's
#         moves never closer than 60 ms, in Settings' list.
#   S2.15 how long Home takes to show the home screen, and choosing the app
#         again to bring it back.
#   S2.16 Home and Back from the keyboard, a gamepad and the mouse: manual.
#
# Stage 0:
#
#   S0.2  the root disk isn't encrypted, so there's no password at boot; the
#         owner logs in on their own; the TV setup welcome screen was shown.
#   S0.3  the Wi-Fi device can be an access point, NetworkManager brings up a
#         WPA2 hotspot on it in AP mode, and Wi-Fi goes back to how it was.
#
# The hotspot takes over Wi-Fi for up to a minute, so S0.3 runs on the box
# itself or over Ethernet. Over SSH on that Wi-Fi it says so and doesn't run.
#
# Exits 0 when every check passed, 1 when one didn't.

set -Eeuo pipefail

AGENTV_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
AGENTV_HEALTH_URL=${AGENTV_HEALTH_URL:-http://127.0.0.1:3000/health}
AGENTV_SDDM_CONF=${AGENTV_SDDM_CONF:-/etc/sddm.conf}
AGENTV_STATE=${AGENTV_STATE:-/var/lib/agentv}
OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}

usage() {
  echo "Usage: agentv selftest [S0.2|S0.3|S1.1|S1.2|S1.5|S1.6|S1.7|S2|S2.8|S2.9|S2.10|S2.11|S2.15|S2.16]..."
}

STAGE2=(S2.8 S2.9 S2.10 S2.11 S2.15 S2.16)
checks=()
for arg in "$@"; do
  case "$arg" in
    [sS]0.2 | [sS]0.3 | [sS]1.1 | [sS]1.2 | [sS]1.5 | [sS]1.6 | [sS]1.7) checks+=("S${arg:1}") ;;
    [sS]2.8 | [sS]2.9 | [sS]2.10 | [sS]2.11 | [sS]2.15 | [sS]2.16) checks+=("S${arg:1}") ;;
    [sS]2) checks+=("${STAGE2[@]}") ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
(( ${#checks[@]} )) || checks=(S1.1 S1.2 S1.5 S1.6 S1.7 "${STAGE2[@]}")

failed=" "
current=""

# Anything that stops the selftest halfway is a failure of the check it was
# on, said on a line of its own, never a quiet end.
trap 'printf "fail %s the selftest stopped at line %s; send this whole output\n" "${current:-?}" "$LINENO"' ERR

# result <pass|fail|manual> <id> <what>
result() {
  printf '%s %s %s\n' "$1" "$2" "$3"
  [[ $1 != "fail" || $failed == *" $2 "* ]] || failed+="$2 "
}

s02_disk() {
  local source types

  source=$(findmnt -no SOURCE -v / 2>/dev/null || true)
  if [[ -z $source ]] || ! types=$(lsblk -nso TYPE "$source" 2>/dev/null); then
    result fail S0.2 "couldn't tell which disk / is on"
  elif grep -qx crypt <<<"${types// /}"; then
    result fail S0.2 "the root disk is encrypted ($source), so it asks for a password at boot"
  else
    result pass S0.2 "the root disk isn't encrypted ($source), so there's no password at boot"
  fi
}

s02_login() {
  local user session

  # SDDM reads sddm.conf.d in name order and sddm.conf last; the last User=
  # in an [Autologin] section wins.
  user=$(
    for file in "$AGENTV_SDDM_CONF.d"/*.conf "$AGENTV_SDDM_CONF"; do
      if [[ -f $file ]]; then cat -- "$file"; fi
    done | awk -F= '/^\[/ { section = $0 } section == "[Autologin]" && $1 == "User" { user = $2 } END { print user }'
  )
  if [[ -z $user ]]; then
    result fail S0.2 "nobody logs in on their own: SDDM has no autologin user"
    return
  fi

  # Columns: SESSION UID USER SEAT, then more.
  session=$(loginctl list-sessions --no-legend 2>/dev/null |
    awk -v user="$user" '!found && $3 == user && $4 == "seat0" { print $1; found = 1 }' || true)
  if [[ -n $session ]]; then
    result pass S0.2 "$user logs in on their own (session $session on seat0)"
  else
    result fail S0.2 "SDDM logs $user in, but $user has no session on the screen right now"
  fi
}

s02_welcome() {
  local health

  health=$(curl -fsS --max-time 5 "$AGENTV_HEALTH_URL" 2>/dev/null || true)
  if [[ -z $health ]]; then
    result fail S0.2 "the daemon doesn't answer at $AGENTV_HEALTH_URL"
  elif [[ $(jq -r '.welcome_shown // false' <<<"$health" 2>/dev/null) == "true" ]]; then
    result pass S0.2 "the TV setup welcome screen was shown ($(jq -r '.welcome_shown_at // "time unknown"' <<<"$health"))"
  else
    result fail S0.2 "the TV setup welcome screen hasn't been shown since the daemon started"
  fi
}

# The awk calls here read to the end: one that stopped early would leave the
# command before it writing into a closed pipe, and with pipefail that ends
# the selftest.

# The first Wi-Fi device NetworkManager knows, or nothing.
wifi_device() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '!found && $2 == "wifi" { print $1; found = 1 }'
}

# The interface modes the device's radio supports, one per line.
ap_modes() {
  iw phy "$1" info 2>/dev/null |
    awk '/Supported interface modes:/ && !done { list = 1; next } list && /^[[:space:]]+\* / { print $2; next } list { list = 0; done = 1 }'
}

# Is this an SSH session that runs over the given device?
ssh_over() {
  local here

  [[ -n ${SSH_CONNECTION:-} ]] || return 1
  here=$(awk '{ print $3 }' <<<"$SSH_CONNECTION")
  ip -o addr show dev "$1" 2>/dev/null | grep -qF " $here/"
}

hotspot=agentv-selftest-hotspot
radio_before=""
uuid_before=""
restored=0

# The connection the device is on now, by UUID, or nothing.
active_uuid() {
  nmcli -g UUID,DEVICE connection show --active 2>/dev/null | awk -F: -v device="$1" '!found && $2 == device { print $1; found = 1 }'
}

# Wi-Fi as it was: no test hotspot, the radio as it was, and the connection
# the device had before, if it had one. Also runs when the selftest is
# stopped halfway.
restore_wifi() {
  (( restored )) && return 0
  restored=1
  sudo nmcli connection down "$hotspot" >/dev/null 2>&1 || true
  sudo nmcli connection delete "$hotspot" >/dev/null 2>&1 || true
  [[ $radio_before == "disabled" ]] && sudo nmcli radio wifi off
  if [[ -n $uuid_before ]]; then
    sudo nmcli --wait 45 connection up uuid "$uuid_before" >/dev/null 2>&1 || true
  fi
}

s03() {
  local device phy driver modes ssid psk state type channel uuid_after

  device=$(wifi_device)
  if [[ -z $device ]]; then
    result fail S0.3 "NetworkManager has no Wi-Fi device"
    return
  fi
  phy=$(cat "/sys/class/net/$device/phy80211/name" 2>/dev/null || true)
  driver=$(basename "$(readlink -f "/sys/class/net/$device/device/driver" 2>/dev/null)" 2>/dev/null || true)
  modes=$(ap_modes "$phy")
  if grep -qx AP <<<"$modes"; then
    result pass S0.3 "the Wi-Fi device can be an access point ($device${driver:+, $driver}${phy:+, $phy})"
  else
    result fail S0.3 "the Wi-Fi device can't be an access point ($device${driver:+, $driver}; modes: $(tr '\n' ' ' <<<"$modes"))"
    return
  fi

  if ssh_over "$device"; then
    result fail S0.3 "not run: this SSH session goes over $device, which the hotspot takes over for up to a minute. Run it on the box or over Ethernet."
    return
  fi

  radio_before=$(nmcli radio wifi 2>/dev/null || true)
  uuid_before=$(active_uuid "$device")
  trap restore_wifi EXIT
  trap 'restore_wifi; exit 130' HUP INT TERM

  [[ $radio_before == "enabled" ]] || sudo nmcli radio wifi on

  # WPA2 with a throwaway passphrase that's never shown. A fixed address,
  # because handing out addresses to phones comes with TV setup's own hotspot.
  ssid="AgenTV-selftest-$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')"
  psk=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
  sudo nmcli connection delete "$hotspot" >/dev/null 2>&1 || true
  if ! sudo nmcli connection add type wifi ifname "$device" con-name "$hotspot" autoconnect no ssid "$ssid" \
    802-11-wireless.mode ap 802-11-wireless.band bg \
    wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp \
    wifi-sec.pmf disable wifi-sec.psk "$psk" \
    ipv4.method manual ipv4.addresses 10.42.0.1/24 ipv6.method disabled >/dev/null 2>&1; then
    result fail S0.3 "NetworkManager wouldn't take the hotspot's settings"
    restore_wifi
    return
  fi

  sudo nmcli --wait 45 connection up "$hotspot" >/dev/null 2>&1 || true
  state=$(nmcli -g GENERAL.STATE connection show "$hotspot" 2>/dev/null || true)
  type=$(iw dev "$device" info 2>/dev/null | awk '$1 == "type" { print $2 }')
  channel=$(iw dev "$device" info 2>/dev/null | awk '$1 == "channel" { print $2 }')
  if [[ $state == "activated" && $type == "AP" ]]; then
    result pass S0.3 "NetworkManager brought up a WPA2 hotspot in AP mode ($ssid on channel ${channel:-unknown})"
  else
    result fail S0.3 "NetworkManager didn't bring up the hotspot (connection: ${state:-not active}, device mode: ${type:-unknown}); journalctl -u NetworkManager says why"
  fi

  restore_wifi
  trap - EXIT HUP INT TERM

  if nmcli -g NAME connection show 2>/dev/null | grep -qx "$hotspot"; then
    result fail S0.3 "the test hotspot is still there; remove it with: sudo nmcli connection delete $hotspot"
  elif [[ -n $uuid_before ]]; then
    uuid_after=$(active_uuid "$device")
    if [[ $uuid_after == "$uuid_before" ]]; then
      result pass S0.3 "Wi-Fi is back on $(nmcli -g connection.id connection show uuid "$uuid_before" 2>/dev/null)"
    else
      result fail S0.3 "Wi-Fi didn't reconnect to $(nmcli -g connection.id connection show uuid "$uuid_before" 2>/dev/null) on its own; reconnect from the Wi-Fi menu"
    fi
  else
    result pass S0.3 "Wi-Fi is back as it was (it wasn't connected before)"
  fi
}

# --- Stage 1: the TV session ------------------------------------------------

# The screen daemon's answer to a request, or nothing when the TV session
# isn't on. The status says what's in front, every window and the overlays.
screen() {
  "${AGENTV_SCREEN:-$AGENTV_BIN_DIR/agentv-screen}" "$@" 2>/dev/null || true
}

# The value of a jq filter on the screen daemon's status.
front() {
  jq -r "$1" <<<"$(screen status)" 2>/dev/null || true
}

# wait_front <role> <seconds>: waits until that role is in front, and prints
# how long it took, in tenths of a second, or nothing.
wait_front() {
  local tenths=0
  while (( tenths < $2 * 10 )); do
    [[ $(front '.front.role // ""') == "$1" ]] && { echo "$tenths"; return 0; }
    sleep 0.2
    tenths=$(( tenths + 2 ))
  done
}

seconds() {
  printf '%d.%d s' "$(( $1 / 10 ))" "$(( $1 % 10 ))"
}

# The last value of a key in SDDM's [Autologin] section; files in sddm.conf.d
# are read in name order, sddm.conf last.
autologin() {
  for file in "$AGENTV_SDDM_CONF.d"/*.conf "$AGENTV_SDDM_CONF"; do
    if [[ -f $file ]]; then cat -- "$file"; fi
  done | awk -F= -v key="$1" '/^\[/ { section = $0 } section == "[Autologin]" && $1 == key { value = $2 } END { print value }'
}

tv_on() {
  local status

  status=$(screen status)
  if [[ -z $status ]]; then
    result fail "$1" "the TV session isn't on here; go back to the TV (Super+Ctrl+Home on Omarchy's desktop) and run this over SSH"
    return 1
  fi
}

s11() {
  local session relogin home omarchy

  session=$(autologin Session)
  relogin=$(autologin Relogin)
  if [[ $session == "agentv.desktop" && $relogin == "true" ]]; then
    result pass S1.1 "SDDM logs $(autologin User) in to the TV session, and back in after every log-out"
  else
    result fail S1.1 "SDDM logs in to ${session:-no session} (Relogin=${relogin:-false}); agentv update moves the box to the TV session"
  fi

  tv_on S1.1 || return 0
  home=$(front 'select(.front.role == "home") | "\(.front.workspace) \(.front.fullscreen)"')
  if [[ $home == "1 2" ]]; then
    result pass S1.1 "the TV session is on, with the home screen in front, full screen"
  else
    result fail S1.1 "the TV session is on, but the home screen isn't in front ($(front '.front.role // "nothing"'))"
  fi

  omarchy=""
  pgrep -u "$(id -u)" -f "$OMARCHY_PATH/shell" >/dev/null 2>&1 && omarchy+="Omarchy's shell (bar, notices, screensaver, idle lock), "
  systemctl --user is-active --quiet graphical-session.target 2>/dev/null && omarchy+="graphical-session.target, "
  [[ -n $(front '.layers[] | select(startswith("omarchy"))') ]] && omarchy+="an Omarchy overlay, "
  if [[ -z $omarchy ]]; then
    result pass S1.1 "nothing of Omarchy's desktop runs in the TV session: no bar, notices, screensaver or idle lock"
  else
    result fail S1.1 "Omarchy's desktop runs in the TV session: ${omarchy%, }"
  fi
}

s12() {
  local manifest version

  manifest=$(find "$AGENTV_STATE/chromium/WidevineCdm" -name manifest.json 2>/dev/null | sort | tail -n 1 || true)
  if [[ -n $manifest ]]; then
    version=$(jq -r '.version // "unknown"' "$manifest" 2>/dev/null || echo unknown)
    result pass S1.2 "the services' Chromium has its Widevine module ($version)"
  else
    result fail S1.2 "the services' Chromium has no Widevine module yet; open a page with agentv screen open <address>, wait five minutes, and run this again"
  fi
  result manual S1.2 "sign in with agentv screen open <the service's address>, then play something for 10 minutes at 720p: no stutter, and no fan from the couch"
}

s15() {
  local frames fps slow refresh took back

  tv_on S1.5 || return 0

  frames=$(screen frames 5)
  fps=$(jq -r '.fps // empty' <<<"$frames" 2>/dev/null || true)
  slow=$(jq -r '.slow_frames // empty' <<<"$frames" 2>/dev/null || true)
  refresh=$(front '.monitors[0].refresh_rate // 60 | floor')
  if [[ -z $fps ]]; then
    result fail S1.5 "couldn't measure the home screen's frames: $(jq -r '.error // "no answer"' <<<"$frames" 2>/dev/null)"
  elif awk -v fps="$fps" -v refresh="$refresh" -v slow="$slow" 'BEGIN { exit !(fps >= refresh - 2 && slow == 0) }'; then
    result pass S1.5 "the home screen draws at $fps fps on a $refresh Hz screen, with no frame over 25 ms"
  else
    result fail S1.5 "the home screen draws at $fps fps on a $refresh Hz screen, with $slow frames over 25 ms"
  fi

  # Any page will do for an app in front; the box's own logo is always there.
  screen open "http://127.0.0.1:3000/logo.svg" >/dev/null
  took=$(wait_front web 15)
  if [[ -n $took ]]; then
    result pass S1.5 "a web app came in front in $(seconds "$took")"
    screen toast "AgenTV selftest: this toast is over the app in front" >/dev/null
    sleep 1
    if [[ -n $(front '.layers[] | select(. == "agentv-toast")') ]]; then
      result pass S1.5 "a toast showed over the app in front"
    else
      result fail S1.5 "the toast didn't show over the app in front"
    fi
    screen home >/dev/null
    back=$(wait_front home 10)
    if [[ -n $back ]]; then
      result pass S1.5 "the home screen came back in front in $(seconds "$back")"
    else
      result fail S1.5 "the home screen didn't come back in front"
    fi
    screen close web >/dev/null
  else
    result fail S1.5 "a web app didn't come in front within 15 s"
  fi

  if ! omarchy-cmd-present steam; then
    result fail S1.5 "Steam isn't installed; on Omarchy's desktop: Install > Gaming > Steam, then run agentv selftest S1.5 again"
  else
    screen open steam >/dev/null
    took=$(wait_front steam 90)
    if [[ -n $took && $(front '.front.class') == "gamescope" ]]; then
      result pass S1.5 "Steam came in front in its own gamescope in $(seconds "$took")"
    else
      result fail S1.5 "Steam didn't come in front in its gamescope within 90 s"
    fi
    screen home >/dev/null
    screen close steam >/dev/null
  fi

  result manual S1.5 "watch: the home screen moves smoothly, an app and home again show nothing of the desktop or a browser, a toast shows over a playing film (agentv screen toast hello), and Steam's games pace well in its gamescope. If Hyprland fails this, gamescope as the TV session's compositor is next (ADR-031)."
}

s16() {
  local display stray pid where before took

  tv_on S1.6 || return 0

  # A window opened in the TV session by someone else: a terminal.
  display=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p')
  if [[ -z $display ]] || ! omarchy-cmd-present foot; then
    result fail S1.6 "couldn't open a window in the TV session to try (no WAYLAND_DISPLAY or no foot)"
  else
    WAYLAND_DISPLAY=$display setsid foot --title "agentv selftest" sleep 30 >/dev/null 2>&1 &
    stray=$!
    sleep 3
    where=$(front '.windows[] | select(.title == "agentv selftest") | .workspace')
    if [[ $where == "special:agentv-held" && $(front '.front.role') == "home" ]]; then
      result pass S1.6 "a new window stayed out of sight, and the home screen stayed in front"
    else
      result fail S1.6 "a new window went to ${where:-nowhere}, with $(front '.front.role // "nothing"') in front"
    fi
    kill "$stray" 2>/dev/null || true
  fi

  # The home screen crashing.
  pid=$(front '.apps[] | select(.role == "home") | .pid')
  before=$(front '.home_restarts')
  if [[ -z $pid ]]; then
    result fail S1.6 "the screen daemon didn't start the home screen"
    return 0
  fi
  kill -KILL "$pid" 2>/dev/null || true
  sleep 1
  took=$(wait_front home 20)
  if [[ -n $took && $(front '.home_restarts') -gt $before && $(front '.apps[] | select(.role == "home") | .pid') != "$pid" ]]; then
    result pass S1.6 "the home screen came back in front $(seconds $(( took + 10 ))) after a crash"
  else
    result fail S1.6 "the home screen didn't come back in front within 20 s of a crash"
  fi
}

# --- ADR-032: no browser prompts on the TV ---------------------------------

s17() {
  local prefs="$AGENTV_STATE/chromium/Default/Preferences"

  if [[ ! -f $prefs ]]; then
    result fail S1.7 "the services' Chromium has no profile yet; open a page with agentv screen open <address> and run this again"
  elif [[ $(jq -r '.credentials_enable_service == false and .credentials_enable_autosignin == false and .autofill.profile_enabled == false and .autofill.credit_card_enabled == false and .translate.enabled == false and .profile.default_content_setting_values.notifications == 2' "$prefs" 2>/dev/null) == "true" ]]; then
    result pass S1.7 "the services' Chromium has saving passwords, address and card autofill, translate and site notifications off"
  else
    result fail S1.7 "the services' Chromium still has some of its own prompts on; agentv update and a reboot turn them off"
  fi
  result manual S1.7 "sign in to a streaming service again, with a keyboard on the box: no Save password, Translate or notification bubble shows on the TV, and you stay signed in after a reboot"
}

# --- Stage 2: the home screen -----------------------------------------------

input() {
  "${AGENTV_INPUT:-$AGENTV_BIN_DIR/agentv-input}" "$@" >/dev/null 2>&1 || true
}

# A number from a jq filter on a file, or nothing.
value() {
  jq -r "$1 // empty" "$2" 2>/dev/null || true
}

# ms_until <role> <seconds> <start>: waits until that role is in front, and
# prints the milliseconds since start (date +%s%N), or nothing.
ms_until() {
  local deadline=$(( $3 + $2 * 1000000000 ))
  while (( $(date +%s%N) < deadline )); do
    if [[ $(front '.front.role // ""') == "$1" ]]; then
      echo $(( ($(date +%s%N) - $3) / 1000000 ))
      return 0
    fi
    sleep 0.05
  done
}

# Stage 2 measures the home screen itself, so TV setup has to be done: until
# then the welcome page is on the TV, with no tiles and no UI sounds.
launcher_on() {
  local health

  health=$(curl -fsS --max-time 5 "$AGENTV_HEALTH_URL" 2>/dev/null || true)
  if [[ $(jq -r '.screen // ""' <<<"$health" 2>/dev/null || true) != "home" ]]; then
    result fail "$1" "the TV is still on its setup welcome page; finish TV setup, or run agentv setup skip, then run this again"
    return 1
  fi
}

# The home screen in front, with nothing else open, for a measurement.
home_alone() {
  screen home >/dev/null
  wait_front home 10 >/dev/null
  sleep 1
}

s28() {
  local connectors seen

  tv_on S2.8 || return 0
  connectors=$(for status in /sys/class/drm/card*-*/status; do
    if [[ -f $status && $(<"$status") == "connected" ]]; then basename "$(dirname "$status")"; fi
  done | sed 's/^card[0-9]*-//' | paste -sd, -)
  if [[ $(front '.tv') == "on" ]]; then
    result pass S2.8 "the box reads the TV as on${connectors:+, from $connectors}, and looks every 2 s"
  else
    result fail S2.8 "the box reads the TV as off while it's on${connectors:+ (connected: $connectors)}; agentv screen status says so too"
  fi
  result manual S2.8 "play an episode, then turn the TV off with its own remote: it pauses within 5 s. Leave it off for 2 minutes and turn it on: home is on its ambient screen, and the episode's app has closed. Then run agentv selftest S2.8 again: it lists what the box saw."
  seen=$(journalctl --user -b --no-pager -o short-iso -u agentv-screen 2>/dev/null |
    grep -E "the TV went off|the TV came back on|the TV has been off|the ambient screen ends" | tail -n 6 || true)
  while IFS= read -r line; do
    if [[ -n $line ]]; then result manual S2.8 "seen at ${line%% *}: ${line#*]: }"; fi
  done <<<"$seen"
}

s29() {
  local out

  tv_on S2.9 || return 0
  home_alone
  out=$(mktemp)
  screen keys 3 >"$out" &
  sleep 1
  input key right
  input key left
  wait $! || true
  if [[ $(value '[.keys[] | select(. == "ArrowRight" or . == "ArrowLeft")] | length' "$out") == "2" ]]; then
    result pass S2.9 "a key on the virtual input device reaches the home screen"
  else
    result fail S2.9 "the home screen didn't get the keys sent ($(value '.keys | join(" ")' "$out"))"
  fi
  rm -f "$out"
  result manual S2.9 "with the TV back on after S2.8, press a key: the launcher is back within 10 s"
}

s210() {
  local out fps slow refresh

  tv_on S2.10 || return 0
  launcher_on S2.10 || return 0
  home_alone
  refresh=$(front '.monitors[0].refresh_rate // 60 | floor')
  out=$(mktemp)
  screen frames 8 >"$out" &
  sleep 0.5
  # The focus glides from tile to tile, then the mouse lifts tiles as it
  # passes, then a page slides in and back out.
  for key in right right down left left up; do
    input key "$key"
    sleep 0.4
  done
  input move -4000 -4000
  input move 300 300
  for _ in 1 2 3 4; do
    input move 420 0
    sleep 0.3
  done
  input key i
  sleep 1.2
  input key back
  wait $! || true
  fps=$(value '.fps' "$out")
  slow=$(value '.slow_frames' "$out")
  if [[ -z $fps ]]; then
    result fail S2.10 "couldn't measure the home screen's frames: $(value '.error' "$out")"
  elif awk -v fps="$fps" -v refresh="$refresh" -v slow="$slow" 'BEGIN { exit !(fps >= refresh - 2 && slow == 0) }'; then
    result pass S2.10 "with the focus gliding, tiles lifting under the mouse and a page sliding in and out, the home screen drew at $fps fps on a $refresh Hz screen, with no frame over 25 ms"
  else
    result fail S2.10 "with the focus gliding, tiles lifting and a page sliding, the home screen drew at $fps fps on a $refresh Hz screen, with $slow frames over 25 ms (worst $(value '.worst_ms' "$out") ms)"
  fi
  rm -f "$out"
  home_alone
  result manual S2.10 "watch: the focus glides between tiles, a tile lifts under the mouse, and pages slide in and out, all smoothly. Settings → Look → reduce motion turns them into fades; turn it off again after."
}

s211() {
  local out on worst closest

  tv_on S2.11 || return 0
  launcher_on S2.11 || return 0
  home_alone
  out=$(mktemp)
  # The measurement starts in Settings, whose list always has somewhere for
  # an arrow to go.
  screen sounds 7 >"$out" &
  sleep 1
  for key in down up down up; do
    input key "$key"
    sleep 0.5
  done
  # A held arrow repeats faster than one move sound every 60 ms.
  input hold down 1.5
  input hold up 1.5
  wait $! || true
  on=$(value '.on' "$out")
  worst=$(value '.worst_ms' "$out")
  closest=$(value '.closest_moves_ms' "$out")
  if [[ -n $(value '.error' "$out") || $on != "true" ]]; then
    if [[ -n $(value '.error' "$out") ]]; then
      result fail S2.11 "couldn't measure the UI sounds: $(value '.error' "$out")"
    else
      result fail S2.11 "Settings → Sound has the UI sounds off; turn them on and run this again"
    fi
    rm -f "$out"
    return 0
  fi
  if [[ -z $worst ]]; then
    result fail S2.11 "no UI sound played for the keys sent (audio: $(value '.audio' "$out"))"
  elif awk -v worst="$worst" 'BEGIN { exit !(worst <= 16.7) }'; then
    result pass S2.11 "each UI sound started within $worst ms of its key reaching the page, inside one frame; the audio output adds about $(value '.output_ms' "$out") ms"
  else
    result fail S2.11 "a UI sound started $worst ms after its key reached the page, more than a frame"
  fi
  if [[ -n $closest ]] && (( closest >= 59 )); then
    result pass S2.11 "a held arrow played a move sound at most every 60 ms (the closest two: $closest ms)"
  elif [[ -n $closest ]]; then
    result fail S2.11 "two move sounds played $closest ms apart, closer than 60 ms"
  else
    result fail S2.11 "a held arrow played fewer than two move sounds"
  fi
  rm -f "$out"
  home_alone
  result manual S2.11 "listen: each of the seven sounds comes with its action, a held arrow ticks evenly, and Settings → Sound → ui sounds off silences them all; turn them on again after"
}

s215() {
  local page="http://127.0.0.1:3000/logo.svg" start took

  tv_on S2.15 || return 0
  screen open "$page" >/dev/null
  if [[ -z $(wait_front web 15) ]]; then
    result fail S2.15 "a web app didn't come in front within 15 s"
    return 0
  fi
  sleep 2
  start=$(date +%s%N)
  screen home >/dev/null
  took=$(ms_until home 5 "$start")
  if [[ -n $took ]] && (( took <= 1000 )); then
    result pass S2.15 "Home put the home screen in front in $took ms"
  else
    result fail S2.15 "Home took ${took:-over 5000} ms to put the home screen in front"
  fi
  sleep 2
  start=$(date +%s%N)
  screen open "$page" >/dev/null
  took=$(ms_until web 5 "$start")
  if [[ -n $took ]] && (( took <= 1000 )); then
    result pass S2.15 "choosing the app again brought the same window back in $took ms"
  else
    result fail S2.15 "choosing the app again took ${took:-over 5000} ms"
  fi
  screen home >/dev/null
  wait_front home 10 >/dev/null
  screen close web >/dev/null
  result manual S2.15 "with an episode playing: Home pauses it and home shows within a second, and choosing it again plays it from the same second within a second"
}

s216() {
  tv_on S2.16 || return 0
  result manual S2.16 "over a playing app: the keyboard's Home key, a gamepad's guide button and the mouse pushed into the top left corner, then a click on Home there, each show the home screen. Back reaches the app, and holding Back for a second goes home. In a game, the guide button stays the game's."
}

echo "AgenTV selftest, $(date -u +%Y-%m-%dT%H:%MZ), $(uname -n)"
"$AGENTV_BIN_DIR/agentv-version" 2>/dev/null || true
echo

for id in "${checks[@]}"; do
  current=$id
  case $id in
    S0.2) s02_disk; s02_login; s02_welcome ;;
    S0.3) s03 ;;
    S1.1) s11 ;;
    S1.2) s12 ;;
    S1.5) s15 ;;
    S1.6) s16 ;;
    S1.7) s17 ;;
    S2.8) s28 ;;
    S2.9) s29 ;;
    S2.10) s210 ;;
    S2.11) s211 ;;
    S2.15) s215 ;;
    S2.16) s216 ;;
  esac
done

echo
summary=""
for id in "${checks[@]}"; do
  if [[ $failed == *" $id "* ]]; then summary+="${summary:+, }$id fail"; else summary+="${summary:+, }$id pass"; fi
done
echo "$summary"

# The exit status says whether everything passed; that's not a stop.
trap - ERR
[[ $failed == " " ]]
