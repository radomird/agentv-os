#!/bin/bash

# agentv:summary=Ask the TV session what's on screen, or put something in front
# agentv:args=status | home | open <url> | open steam | app <id> [item] | sign-in <id> | signed-in | quit <app> | close <home|web|steam> | ambient | tv <on|off> | update <check|install|go-back> | power <restart|shutdown> | pin <action> | settings [section] | apps [add] | audio [output <name>|volume <0-100>] | toast <text> | frames [seconds] | keys [seconds] | sounds [seconds]
# agentv:examples=agentv screen status | agentv screen open https://example.org | agentv screen toast "Hello"

# Talks to AgenTV's screen daemon (daemon/screen.ts), which decides what's in
# front of the TV in the TV session (ADR-031). Works over SSH too, as the
# person logged in on the TV. Prints the daemon's answer as JSON, and exits 0
# when it says ok, 1 when it doesn't, and 2 when the TV session isn't on.
#
#   status         what's in front, every window and where it is, the apps
#                  the daemon started, the apps open, the screen and the
#                  overlays
#   home           Home: the app in front pauses, and the home screen comes
#                  to the front
#   open <url>     a web page in the services' Chromium, in front; one open
#                  already comes back where it was
#   open steam     Steam in its own gamescope, in front
#   app <id> [item]  an installed app, in front, the way choosing its tile
#                  opens it; while it's open, its playback goes to the ledger.
#                  With an item, a JSON object such as {"kind":"episode",
#                  "title":"...","season":1,"episode":2}, the app opens it
#                  through its playback.open, as a tile's entry does
#   sign-in <id>   an installed app's sign-in screen: its service's page,
#                  with AgenTV's bar under it, until the app says it's
#                  signed in (ADR-032)
#   signed-in      "i'm signed in" on that bar: the app is asked now
#   quit <app>     close an app that's open, such as a game behind home
#   ambient        the ambient screen now, over whatever's in front
#   tv <on|off>    what happens when the TV goes off or comes back, as if it
#                  had (the box reads the TV's power itself)
#   update <check|install|go-back>  Settings → Updates' Check now, Install
#                  now and Go back
#   power <restart|shutdown>  Settings → Power's Restart, and Shut down once
#                  its countdown ends: the box restarts or turns off now
#   pin <action>   the adult PIN, asked for on the TV in front, for an
#                  action such as desktop: prints the grant it gives
#   settings [section]  Settings on the TV, at a section such as power
#   apps [add]     Apps on the TV, or its add an app
#   audio          the sound outputs, which one plays and at what volume
#   audio output <name>  Settings → Sound's output: this one, from now on
#   audio volume <0-100>  Settings → Sound's volume for the output playing
#   idle-after <s|off>  the ambient screen after s seconds with no input,
#                  instead of Settings' time, until the session ends
#   close <role>   close the home screen, the web apps or Steam
#   toast <text>   a toast over whatever's in front
#   frames [s]     how smoothly the home screen draws, over s seconds
#   keys [s]       the keys the home screen gets over s seconds
#   sounds [s]     the UI sounds the home screen plays for those keys, and
#                  how soon after each key

set -euo pipefail

AGENTV_PATH=${AGENTV_PATH:-/usr/share/agentv}

usage() {
  sed -n 's/^# agentv:args=/Usage: agentv screen /p' "${BASH_SOURCE[0]}" | head -n 1
}

command=${1:-status}
(( $# )) && shift

case "$command" in
  status | home)
    request=$(jq -cn --arg cmd "$command" '{cmd: $cmd}')
    ;;
  back)
    # The session's Hyprland, on each press and release of Back:
    # agentv screen back down|up <milliseconds since 1970>.
    (( $# == 2 )) && [[ $1 == "down" || $1 == "up" ]] && [[ $2 =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
    request=$(jq -cn --arg edge "$1" --argjson at "$2" '{cmd: "back", edge: $edge, at: $at}')
    ;;
  quit)
    (( $# == 1 )) || { usage >&2; exit 2; }
    request=$(jq -cn --arg app "$1" '{cmd: "quit", app: $app}')
    ;;
  ambient)
    request='{"cmd":"ambient"}'
    ;;
  update)
    (( $# == 1 )) && [[ $1 == "check" || $1 == "install" || $1 == "go-back" ]] || { usage >&2; exit 2; }
    request=$(jq -cn --arg what "$1" '{cmd: "update", what: $what}')
    ;;
  power)
    (( $# == 1 )) && [[ $1 == "restart" || $1 == "shutdown" ]] || { usage >&2; exit 2; }
    request=$(jq -cn --arg what "$1" '{cmd: "power", what: $what}')
    ;;
  pin)
    (( $# == 1 )) && [[ $1 =~ ^[a-z-]{1,20}$ ]] || { usage >&2; exit 2; }
    request=$(jq -cn --arg action "$1" '{cmd: "pin", action: $action}')
    ;;
  settings)
    (( $# <= 1 )) || { usage >&2; exit 2; }
    request=$(jq -cn --arg section "${1:-}" '{cmd: "settings", section: $section}')
    ;;
  apps)
    (( $# == 0 )) || { (( $# == 1 )) && [[ $1 == "add" ]]; } || { usage >&2; exit 2; }
    request=$(jq -cn --arg page "${1:-}" '{cmd: "apps", page: $page}')
    ;;
  audio)
    if (( $# == 0 )); then
      request='{"cmd":"audio"}'
    elif (( $# == 2 )) && [[ $1 == "output" ]]; then
      request=$(jq -cn --arg output "$2" '{cmd: "audio", output: $output}')
    elif (( $# == 2 )) && [[ $1 == "volume" && $2 =~ ^[0-9]+$ ]] && (( $2 <= 100 )); then
      request=$(jq -cn --argjson volume "$2" '{cmd: "audio", volume: ($volume / 100)}')
    else
      usage >&2
      exit 2
    fi
    ;;
  tv)
    (( $# == 1 )) && [[ $1 == "on" || $1 == "off" ]] || { usage >&2; exit 2; }
    request=$(jq -cn --argjson on "$([[ $1 == "on" ]] && echo true || echo false)" '{cmd: "tv", on: $on}')
    ;;
  idle)
    # The TV session's overlay, when the seat goes idle and when it's back.
    (( $# == 1 )) && [[ $1 == "yes" || $1 == "no" ]] || { usage >&2; exit 2; }
    request=$(jq -cn --argjson idle "$([[ $1 == "yes" ]] && echo true || echo false)" '{cmd: "idle", idle: $idle}')
    ;;
  idle-after)
    (( $# == 1 )) && [[ $1 =~ ^([0-9]+|off)$ ]] || { usage >&2; exit 2; }
    if [[ $1 == "off" ]]; then
      request='{"cmd":"idle-after","seconds":null}'
    else
      request=$(jq -cn --argjson seconds "$1" '{cmd: "idle-after", seconds: $seconds}')
    fi
    ;;
  open)
    (( $# == 1 )) || { usage >&2; exit 2; }
    if [[ $1 == "steam" ]]; then
      request=$(jq -cn '{cmd: "open", app: "steam"}')
    else
      request=$(jq -cn --arg url "$1" '{cmd: "open", url: $url}')
    fi
    ;;
  app)
    (( $# == 1 || $# == 2 )) || { usage >&2; exit 2; }
    if (( $# == 2 )); then
      if ! jq -e 'type == "object" and (.title | type) == "string"' <<<"$2" >/dev/null 2>&1; then
        echo "agentv screen app: the item is a JSON object with a title, like {\"kind\":\"episode\",\"title\":\"...\",\"season\":1,\"episode\":2}" >&2
        exit 2
      fi
      request=$(jq -cn --arg app "$1" --argjson item "$2" '{cmd: "app", app: $app, item: ({id: "agentv-screen"} + $item)}')
    else
      request=$(jq -cn --arg app "$1" '{cmd: "app", app: $app}')
    fi
    ;;
  sign-in)
    (( $# == 1 )) || { usage >&2; exit 2; }
    request=$(jq -cn --arg app "$1" '{cmd: "sign-in", app: $app}')
    ;;
  signed-in)
    (( $# == 0 )) || { usage >&2; exit 2; }
    request='{"cmd":"signed-in"}'
    ;;
  close)
    (( $# == 1 )) || { usage >&2; exit 2; }
    request=$(jq -cn --arg role "$1" '{cmd: "close", role: $role}')
    ;;
  toast)
    (( $# >= 1 )) || { usage >&2; exit 2; }
    request=$(jq -cn --arg text "$*" '{cmd: "toast", text: $text}')
    ;;
  frames | keys | sounds)
    seconds=${1:-5}
    [[ $seconds =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
    request=$(jq -cn --arg cmd "$command" --argjson seconds "$seconds" '{cmd: $cmd, seconds: $seconds}')
    ;;
  end)
    # agentv desktop's way out of the TV session.
    request='{"cmd":"end"}'
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

exec node "$AGENTV_PATH/daemon/screen-call.ts" "$request"
