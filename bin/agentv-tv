#!/bin/bash

# agentv:summary=Open the TV on this screen
# agentv:examples=agentv tv

# For now that means the TV setup welcome page, full screen in a Chromium
# app window with its own profile in /var/lib/agentv/chromium. Stage 1 gives it
# a TV mode of its own (config/hypr/tv.lua).

set -euo pipefail

AGENTV_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
url="http://127.0.0.1:3000/"

# Until Omarchy's first run has finished, its notifications for the desktop
# keep coming, so the first login also clears them off the TV.
if ! omarchy-done check first-run-user 2>/dev/null; then
  setsid -f "$AGENTV_BIN_DIR/agentv-quiet-first-run" >/dev/null 2>&1
fi

# The daemon starts with the system, and this runs at login, so it's usually
# up already. Give it a moment if not.
for _ in $(seq 1 30); do
  curl -fsS -o /dev/null "${url}health" && break
  sleep 1
done

# One TV window: a second launch on the same profile would only open an
# ordinary window in the one that's running.
if pgrep -u "$(id -u)" -f "user-data-dir=/var/lib/agentv/chromium" >/dev/null; then
  exit 0
fi

# App mode, full screen. Omarchy's Hyprland lets a newly focused window take
# the full screen over (on_focus_under_fullscreen), and --kiosk on Linux is
# only a locked full screen, so on the NUC opening a terminal turned the
# welcome page into an ordinary browser window, tabs and address bar and all.
# An app window has neither, full screen or not.
setsid -f uwsm app -- chromium \
  --app="$url" \
  --start-fullscreen \
  --user-data-dir=/var/lib/agentv/chromium \
  --no-first-run \
  --no-default-browser-check \
  --noerrdialogs \
  --disable-session-crashed-bubble \
  --password-store=basic \
  >/dev/null 2>&1
