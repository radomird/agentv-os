#!/bin/bash

# agentv:summary=Back to the TV: from Omarchy's desktop, or to the home screen in the TV session
# agentv:examples=agentv tv

# In the TV session (ADR-031) this puts the home screen in front. On
# Omarchy's desktop it's Back to TV: it closes the desktop's windows and ends
# Omarchy's session, and the login manager logs back in to the TV session
# (bin/agentv-session). Super+Ctrl+Home on the desktop runs it, until the
# agentv-plugin bar widget does.

set -euo pipefail

AGENTV_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# The TV session answers on the screen daemon's socket.
status=0
"$AGENTV_BIN_DIR/agentv-screen" home >/dev/null 2>&1 || status=$?
case $status in
  0) exit 0 ;;
  2) ;;
  *) echo "The TV session is on, but its screen daemon didn't put the home screen in front." >&2; exit 1 ;;
esac

# Omarchy's desktop: close its windows the way its own Log out does, so apps
# save what they have, then end the session.
omarchy-hyprland-window-close-all >/dev/null 2>&1 || true
sleep 1
if ! uwsm stop >/dev/null 2>&1; then
  echo "Couldn't end Omarchy's session; log out from its menu instead." >&2
  exit 1
fi
