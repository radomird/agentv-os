#!/bin/bash

# agentv:summary=Install an update from the TV, with progress for its Updating screen
# agentv:hidden=true
# agentv:requires-sudo=true

# Install now in Settings → Updates starts agentv-update-tv.service, which runs
# this as root (ADR-025). It runs agentv update as the box's owner, the way
# someone at a terminal would, and writes each step to
# /var/lib/agentv/update/progress.json for the TV's Updating screen. When
# the update needs a restart, the box restarts and comes back to home.
#
# Then the check after the update (bin/agentv-update-after), at once or at
# the boot after the restart. It keeps which snapshot Omarchy's update took
# first in go-back.json, for Go back (bin/agentv-go-back).
#
# Omarchy's update asks sudo for its privileged steps, and nobody is at a
# terminal to type a password. So the owner may use sudo without one for this
# update only, the way AgenTV's first boot does for the boot splash. Omarchy's
# update also runs sudo -v, which asks for a password unless every sudo rule
# for the owner says it needn't, and wheel's own rule doesn't; so the owner
# isn't asked at all for this update, as upstream's own update test does. The
# rule goes right after, and also if anything here fails; its name is the one
# omarchy sudo passwordless uses, so Omarchy's own tmpfiles rule removes it at
# the next boot even if the power goes out halfway through.

set -uo pipefail

AGENTV_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
STATE=${AGENTV_UPDATE_STATE:-/var/lib/agentv/update}
SUDOERS=${AGENTV_SUDOERS_DIR:-/etc/sudoers.d}
MODULES=${AGENTV_MODULES_DIR:-/usr/lib/modules}
CHROMIUM_STATE=${AGENTV_CHROMIUM_STATE:-/var/lib/agentv/chromium}

mkdir -p "$STATE"
chmod 755 "$STATE"

# The root left behind by going back, when the cleanup at boot didn't run.
if [[ -f $STATE/cleanup-pending ]]; then
  "$AGENTV_BIN_DIR/agentv-go-back" --cleanup >/dev/null 2>&1 || true
fi

from_agentv=$(pacman -Q agentv 2>/dev/null | cut -d' ' -f2)
from_omarchy=$(pacman -Q omarchy 2>/dev/null | cut -d' ' -f2)
to_agentv=$(jq -r '.agentv.available // empty' "$STATE/status.json" 2>/dev/null)

# progress <state> <step> <percent> [<detail>]
progress() {
  jq -n --arg state "$1" --arg step "$2" --argjson percent "$3" --arg detail "${4:-}" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg from "$from_agentv" --arg to "$to_agentv" \
    --arg omarchy "$from_omarchy" \
    '{state: $state, step: $step, percent: $percent, detail: $detail, at: $at, from: {agentv: $from, omarchy: $omarchy}, to: {agentv: $to}}' \
    >"$STATE/progress.json.new"
  chmod 644 "$STATE/progress.json.new"
  mv "$STATE/progress.json.new" "$STATE/progress.json"
}

owner=${AGENTV_OWNER:-$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ { print $1; exit }' /etc/passwd)}
if [[ -z $owner ]]; then
  progress failed start 0 "there's no user on this box to update as"
  exit 1
fi
home=$(getent passwd "$owner" | cut -d: -f6)

rule="$SUDOERS/99-omarchy-nopasswd-$owner"
trap 'rm -f "$rule"' EXIT
printf '%s ALL=(root) NOPASSWD: ALL\nDefaults:%s !authenticate\n' "$owner" "$owner" >"$rule"
chmod 0440 "$rule"
if ! visudo -cqf "$rule"; then
  rm -f "$rule"
  progress failed start 0 "couldn't let the update use sudo"
  exit 1
fi

# Snapper's snapshots by number, newest last.
snapshots() {
  omarchy-cmd-present snapper || return 0
  snapper -c root --csvout list --columns number 2>/dev/null | awk -F, 'NR > 1 && $1 + 0 > 0 { print $1 + 0 }'
}
snapshot_before=$(snapshots | tail -n 1)
had_widevine=false
[[ -n $(find "$CHROMIUM_STATE/WidevineCdm" -name manifest.json 2>/dev/null) ]] && had_widevine=true

progress running snapshot 2
log="$STATE/update.log"
: >"$log"
chmod 644 "$log"

# The update's own output, read for its steps: Omarchy's snapshot, pacman's
# (n/m) package lines, then the migrations. It runs in a login shell, as
# someone at the box has: that's where Omarchy's environment, OMARCHY_PATH
# among it, comes from. OMARCHY_UPDATE_LOGGED skips Omarchy's script(1)
# wrapper, as S0.5's check does, since there's no terminal here.
status=0
runuser -u "$owner" -- env HOME="$home" PATH="$AGENTV_BIN_DIR:$PATH" OMARCHY_UPDATE_LOGGED=1 \
  bash -lc "agentv update -y" </dev/null 2>&1 |
  while IFS= read -r line; do
    printf '%s\n' "$line" >>"$log"
    if [[ $line =~ \(\ *([0-9]+)/([0-9]+)\)\ (upgrading|installing|reinstalling|downgrading) ]]; then
      n=${BASH_REMATCH[1]} m=${BASH_REMATCH[2]}
      progress running packages $(( 10 + 80 * n / m )) "$n of $m"
    elif [[ $line == *"Synchronizing package databases"* || $line == *"Starting full system upgrade"* ]]; then
      progress running packages 8
    elif [[ $line == *igrat* ]]; then
      progress running migrations 92
    fi
  done
status=${PIPESTATUS[0]}
rm -f "$rule"

"$AGENTV_BIN_DIR/agentv-update-check" >/dev/null 2>&1 || true

if (( status != 0 )); then
  if [[ $(pacman -Q agentv 2>/dev/null | cut -d' ' -f2) == "$from_agentv" && $(pacman -Q omarchy 2>/dev/null | cut -d' ' -f2) == "$from_omarchy" ]]; then
    # agentv update stops before anything when the nightly run hasn't passed
    # a version it would install (bin/agentv-tested).
    if grep -q "so the update waits" "$log"; then
      progress failed packages 0 "not tested yet"
    else
      progress failed packages 0 "nothing changed"
    fi
  else
    progress failed packages 0 "the update stopped halfway"
  fi
  exit 1
fi

# Go back returns to the first snapshot the update took.
snapshot=$(snapshots | awk -v before="${snapshot_before:-0}" '$1 > before { print; exit }')
if [[ -n $snapshot ]]; then
  jq -n --argjson snapshot "$snapshot" --argjson widevine "$had_widevine" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg from "$from_agentv" --arg omarchy "$from_omarchy" \
    --arg to "$(pacman -Q agentv 2>/dev/null | cut -d' ' -f2)" --arg to_omarchy "$(pacman -Q omarchy 2>/dev/null | cut -d' ' -f2)" \
    '{snapshot: $snapshot, widevine: $widevine, at: $at, from: {agentv: $from, omarchy: $omarchy}, to: {agentv: $to, omarchy: $to_omarchy}}' \
    >"$STATE/go-back.json"
  chmod 644 "$STATE/go-back.json"
else
  rm -f "$STATE/go-back.json"
fi
rm -f "$STATE/after.json"

# A new kernel takes a restart, as does anything Omarchy's update says needs
# one. The check runs once the box is up again (agentv-update-after.service).
if [[ ! -d $MODULES/$(uname -r) || -f $home/.local/state/omarchy/reboot-required ]]; then
  touch "$STATE/check-pending"
  progress restarting restart 98
  sleep 3
  systemctl reboot
  exit 0
fi
progress running restart 96 "checking"
"$AGENTV_BIN_DIR/agentv-update-after" >>"$log" 2>&1 || true
progress "done" restart 100
