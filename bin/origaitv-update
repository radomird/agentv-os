#!/bin/bash

# origaitv:summary=Update OrigaiTV, Omarchy and the system packages in place
# origaitv:args=[-y] [--untested]
# origaitv:examples=origaitv update | origaitv update -y
# origaitv:requires-sudo=true

# OrigaiTV ships as its own package beside Omarchy's (ADR-025), so Omarchy's own
# update moves both: one snapshot, one pacman -Syu for Arch, Omarchy and
# OrigaiTV, then Omarchy's migrations and its post-update hook, where OrigaiTV's
# own migrations run (config/omarchy/hooks/post-update.d/origaitv).

set -euo pipefail

ORIGAITV_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

untested=0
yes=0
args=()
for arg in "$@"; do
  case "$arg" in
    --untested) untested=1 ;;
    -y) yes=1 ;;
    *) args+=("$arg") ;;
  esac
done

# Omarchy writes /etc/pacman.conf from its own template, which doesn't know
# about OrigaiTV's repository. Put it back first, or OrigaiTV never updates.
sudo "$ORIGAITV_BIN_DIR/origaitv-pacman-conf"

# Only versions OrigaiTV's nightly run has passed (ADR-026). That run tests the
# release, so it holds back stable. edge takes every green build of origaitv-os
# (ADR-025), newer than any night's, so it skips the check, and so does
# --untested.
if [[ $("$ORIGAITV_BIN_DIR/origaitv-channel") == "edge" ]]; then
  echo "On edge: taking OrigaiTV's newest green build, without waiting for the nightly run."
elif (( ! untested )); then
  "$ORIGAITV_BIN_DIR/origaitv-tested" || exit 1
fi

# OrigaiTV asks its own question, with OrigaiTV's versions and release notes
# (ADR-029), so Omarchy's update runs with -y and skips its own.
if (( ! yes )); then
  "$ORIGAITV_BIN_DIR/origaitv-update-confirm" || exit 1
fi

exec omarchy-update -y ${args[@]+"${args[@]}"}
