#!/bin/bash

# agentv:summary=List the apps on this box, with their version and tier

# One line per app: its id, its version and where it came from (its tier).

set -euo pipefail

AGENTV_PATH=${AGENTV_PATH:-/usr/share/agentv}
AGENTV_STATE=${AGENTV_STATE:-/var/lib/agentv}

# Node 22.6 to 22.17 runs TypeScript only when asked.
flags=()
[[ -n $(node -p 'process.features.typescript || ""' 2>/dev/null) ]] || flags+=(--experimental-strip-types)

export AGENTV_PATH AGENTV_STATE
exec node ${flags[@]+"${flags[@]}"} --disable-warning=ExperimentalWarning "$AGENTV_PATH/daemon/apps/cli.ts" list "$@"
