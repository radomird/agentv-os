#!/bin/bash

# origaitv:summary=Put OrigaiTV's logo back on the boot splash after a package replaced it
# origaitv:hidden=true
# origaitv:requires-sudo=true

# Omarchy's splash theme belongs to its omarchy-settings package. Installing
# that package, at install time and with every update of it, puts Omarchy's
# logo on the splash, before OrigaiTV's first boot has had a chance to run and
# again after it. OrigaiTV's pacman hook (60-origaitv-splash.hook) runs this after
# any such transaction (ADR-021, ADR-029): OrigaiTV's logo goes back over
# Omarchy's, and the boot image is rebuilt so the next boot shows it.
#
# Inside the installer's chroot it only puts the logo back: the installer
# builds the boot image itself, once, at the end. The colours stay as they
# are; first boot sets OrigaiTV's through omarchy plymouth set
# (install/tv/branding.sh).

set -euo pipefail

ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}
theme=${ORIGAITV_SPLASH_THEME:-/usr/share/plymouth/themes/omarchy}
logo="$ORIGAITV_PATH/branding/plymouth-logo.png"

# Nothing to do until both are installed, or when it's OrigaiTV's already.
[[ -d $theme && -f $logo ]] || exit 0
cmp -s -- "$logo" "$theme/logo.png" && exit 0

install -m 644 -- "$logo" "$theme/logo.png"
echo "OrigaiTV's logo is back on the boot splash"

if systemd-detect-virt --quiet --chroot; then
  exit 0
fi

if omarchy-cmd-present limine-mkinitcpio; then
  limine-mkinitcpio
else
  mkinitcpio -P
fi
