#!/bin/bash

# agentv:summary=Skip TV setup and go to the home screen

# Marks TV setup as done, so the TV shows the home screen instead of setup,
# whichever step it's on. What setup has done so far stays done.

set -euo pipefail

port=${AGENTV_PORT:-3000}
if ! curl -fsS --max-time 5 -o /dev/null -H 'Content-Type: application/json' \
  -d '{"done": true}' "http://127.0.0.1:$port/api/setup"; then
  echo "AgenTV's daemon isn't answering. Try: sudo systemctl restart agentv-daemon" >&2
  exit 1
fi
echo "Setup is marked done, so the TV shows the home screen."
