#!/bin/bash

# origaitv:summary=Press keys or type text on the TV, through its virtual input device
# origaitv:args=key <name>... | hold <name> <seconds> | text <text> | move <dx> <dy> | click [button]
# origaitv:examples=origaitv input key down enter | origaitv input hold back 1.2 | origaitv input text "hello" | origaitv input move -4000 -4000

# Sends keys to origaiTV's virtual input device, "origaiTV remote"
# (daemon/input.py, ADR-008), which the TV session runs. They reach whatever
# is in front, the way the phone's d-pad and keyboard will. Keys: up, down,
# left, right, enter, back (Esc), home, playpause, volumeup, volumedown,
# mute, letters and digits. hold keeps one down for a while, such as Back
# for a second, which goes home. move and click are the mouse: pushed far
# enough, the pointer stops in a corner, such as the top left one with Home
# (ADR-031). Works over SSH too, as the person on the TV. What text types is
# never logged (ADR-032); text - reads it from stdin, so it isn't on the
# command line either.

set -euo pipefail

ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}

case "${1:-}" in
  key | hold | text | move | click) exec python3 "$ORIGAITV_PATH/daemon/input.py" "$@" ;;
  *)
    echo "Usage: origaitv input key <name>... | hold <name> <seconds> | text <text> | move <dx> <dy> | click [button]" >&2
    exit 2
    ;;
esac
