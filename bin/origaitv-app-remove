#!/bin/bash

# origaitv:summary=Remove an app from this box
# origaitv:args=<app-id>
# origaitv:requires-sudo=true

# Removes the app's folder from /var/lib/origaitv/apps/ and its line from the record.

set -euo pipefail

ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}
ORIGAITV_STATE=${ORIGAITV_STATE:-/var/lib/origaitv}

# The apps belong to the box, so changing them takes sudo, in this terminal.
apps="$ORIGAITV_STATE/apps"
[[ -d $apps ]] || apps=$ORIGAITV_STATE
if [[ ! -w $apps ]] && (( EUID != 0 )); then
  exec sudo -- "$0" "$@"
fi

# Node 22.6 to 22.17 runs TypeScript only when asked.
flags=()
[[ -n $(node -p 'process.features.typescript || ""' 2>/dev/null) ]] || flags+=(--experimental-strip-types)

export ORIGAITV_PATH ORIGAITV_STATE
exec node ${flags[@]+"${flags[@]}"} --disable-warning=ExperimentalWarning "$ORIGAITV_PATH/daemon/apps/cli.ts" remove "$@"
