#!/bin/bash

# agentv:summary=Start TV setup again from the welcome page

# Marks TV setup as not done, so the TV starts it again from the welcome
# screen. Profiles, phones and the PIN stay as they are.
#
# On a TV with an adult PIN, starting setup again needs it, as Settings
# does: AGENTV_PIN=<the PIN> agentv setup reset.

set -euo pipefail

port=${AGENTV_PORT:-3000}
url="http://127.0.0.1:$port"
ask='{"done": false}'
# The PIN goes in on stdin, so it's on no command line. It's sent with the
# ask itself: the TV checks it for this and gives nothing else for it.
[[ -z ${AGENTV_PIN:-} ]] || ask=$(jq -nc --arg pin "$AGENTV_PIN" '{done: false, pin: $pin}')

status=$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d @- "$url/api/setup" <<<"$ask") || status=""
if [[ $status == "403" && -n ${AGENTV_PIN:-} ]]; then
  echo "The TV didn't take the PIN in AGENTV_PIN." >&2
  exit 1
fi
if [[ $status == "403" ]]; then
  echo "This TV has an adult PIN set. Run it again with the PIN: AGENTV_PIN=<the PIN> agentv setup reset" >&2
  exit 1
fi
if [[ $status != "200" ]]; then
  echo "AgenTV's daemon isn't answering. Try: sudo systemctl restart agentv-daemon" >&2
  exit 1
fi
echo "Setup starts again from the welcome page."
