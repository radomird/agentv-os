#!/bin/bash

# agentv:summary=Open or close the hotspot that a phone picks the TV's Wi-Fi through
# agentv:args=start|stop|status
# agentv:requires-sudo=true

# The setup hotspot (ADR-007, stage 4). On first boot with no network, the
# box opens its own Wi-Fi network, AgenTV-<4 characters>, and the TV shows a
# QR code for it. A phone that joins gets an address from dnsmasq, whose name
# server answers every name with the box, and the box sends port 80 to the
# daemon's captive page on port 3002, so the phone opens the page on its own.
# There it picks the home Wi-Fi and types its password. The daemon can't
# touch NetworkManager, so it hands them over the way it hands over the
# provider key (agentv-hotspot.path), and this joins that network, or opens
# the hotspot again with the reason it couldn't.
#
#   agentv hotspot start   open it, from a terminal
#   agentv hotspot stop    close it
#   agentv hotspot status  how it stands
#
# A box installed from the phone carries on with the phone's network: the
# USB stick's first screen opened AgenTV-<4 characters> for the phone, and
# hands its name and password over in /etc/agentv/hotspot.json. At first
# boot this opens that same network, even on Ethernet, so the phone joins
# it again by itself and carries on. The file goes once setup ends, and a
# hotspot opened after that never has its name and password.
#
# After setup, Settings changes the Wi-Fi the same way, with the hotspot
# closed: the daemon hands over a look at the networks nearby, or one to
# join, and a join that doesn't work puts the TV back on the network it was
# on. And a TV that loses its network opens the hotspot again by itself
# (watch, below), so a phone can reach it and pick another.
#
# The rest is for AgenTV's own units, as root: run (agentv-hotspot.service),
# down (after it stops), boot (agentv-hotspot-boot.service), drop
# (agentv-hotspot-drop.service) and watch (agentv-hotspot-watch.service).
# The home Wi-Fi's password never goes on a command line or in a log:
# NetworkManager reads it from a file only root can read.
#
# The watch waits a minute with no network before it opens the hotspot, and
# every five minutes with nobody on it, it closes it for a moment to look
# for the Wi-Fi the TV knows. Its unit's environment can shorten both, for
# checks: AGENTV_HOTSPOT_LOST_AFTER, AGENTV_HOTSPOT_RETRY_AFTER and
# AGENTV_HOTSPOT_REJOIN_WAIT, in seconds. AGENTV_HOTSPOT_WATCH_SKIP names
# devices it doesn't count, such as the cable a test reaches a VM through.

# shellcheck disable=SC2016 # the $names in jq's filters are jq's own

set -euo pipefail

RUN=${AGENTV_HOTSPOT_RUN:-/run/agentv-hotspot}
DAEMON_STATE=${AGENTV_DAEMON_PRIVATE:-/var/lib/agentv/daemon}
DROP=${AGENTV_HOTSPOT_DROP:-$DAEMON_STATE/hotspot-drop/request.json}
# The id the daemon gave the ask this run is answering, if it gave one. It's
# written back as .answered with the write that finishes the ask, so the
# daemon knows that answer is this ask's, and not a write from before it or
# from another ask.
ASKED=""
CONNECTIONS=${AGENTV_NM_CONNECTIONS:-/etc/NetworkManager/system-connections}
HANDED=${AGENTV_HOTSPOT_HANDED:-/etc/agentv/hotspot.json}
PORT=${AGENTV_SETUP_PORT:-3002}
ADDRESS=10.42.0.1
CONNECTION=agentv-setup
TAG=agentv-setup-hotspot
LOST_AFTER=${AGENTV_HOTSPOT_LOST_AFTER:-60}
RETRY_AFTER=${AGENTV_HOTSPOT_RETRY_AFTER:-300}
REJOIN_WAIT=${AGENTV_HOTSPOT_REJOIN_WAIT:-30}
WATCH_SKIP=${AGENTV_HOTSPOT_WATCH_SKIP:-}

# The first Wi-Fi device NetworkManager knows, or nothing. The awk calls here
# read to the end, so the command before them never writes into a closed pipe.
wifi_device() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '!found && $2 == "wifi" { print $1; found = 1 }'
}

state_get() {
  jq -r "$1 // empty" "$RUN/state.json" 2>/dev/null || true
}

# state_set <jq filter> [jq args]: changes state.json, which the daemon and
# the TV read. It's written whole, and anyone may read it: it has the
# hotspot's own password, which the TV shows anyway, and never the home
# Wi-Fi's.
#
# The hotspot's unit, the hand-over and the watch each change it, and each
# reads it, changes one thing and writes it back. So one at a time, behind a
# lock: without it, one that read before another wrote puts the older copy
# back, and a hotspot that's up reads as closed.
state_set() {
  local filter=$1 current='{}' next="$RUN/.state.json.next" lock
  shift
  install -d -m 755 "$RUN"
  exec {lock}>"$RUN/.state.lock"
  flock "$lock"
  [[ -s $RUN/state.json ]] && current=$(cat "$RUN/state.json")
  jq -c "$@" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg asked "$ASKED" "$filter | .at = \$at" <<<"$current" >"$next"
  chmod 644 "$next"
  mv -f "$next" "$RUN/state.json"
  exec {lock}>&-
}

# random <characters> <length>
random() {
  local out
  out=$(head -c 512 /dev/urandom | LC_ALL=C tr -dc "$1")
  printf '%s' "${out:0:$2}"
}

setup_done() {
  [[ $(jq -r '.done // false' "$DAEMON_STATE/setup.json" 2>/dev/null) == "true" ]]
}

# The network the USB stick's first screen opened for a phone, as "<ssid>
# <password>", or nothing. It's for setup only: once setup is done the file
# goes, so the hotspot a TV that lost its network opens doesn't have the
# name and password a phone was given back at the installer.
handed() {
  local ssid password
  [[ -f $HANDED ]] || return 0
  if setup_done; then
    rm -f "$HANDED"
    return 0
  fi
  ssid=$(jq -r '.ssid // empty' "$HANDED" 2>/dev/null || true)
  password=$(jq -r '.password // empty' "$HANDED" 2>/dev/null || true)
  if [[ $ssid =~ ^AgenTV-[0-9a-f]{4}$ && $password =~ ^[a-z0-9]{8,63}$ ]]; then
    printf '%s %s\n' "$ssid" "$password"
  fi
}

# The networks the radio can see, strongest first, as JSON. It looks before
# it becomes an access point, because then it can't. nmcli's terse lines are
# signal:security:name, with any colon in the name escaped.
scan() {
  {
    nmcli -t -f SIGNAL,SECURITY,SSID device wifi list --rescan yes ifname "$1" ||
      nmcli -t -f SIGNAL,SECURITY,SSID device wifi list --rescan no ifname "$1"
  } 2>/dev/null | jq -Rcs '
    split("\n")
    | map(capture("^(?<signal>[0-9]*):(?<security>[^:]*):(?<ssid>.+)$")?)
    | map(.ssid |= gsub("\\\\(?<c>.)"; .c))
    | map(select(.ssid | startswith("AgenTV-") | not))
    | map({
        ssid,
        signal: (.signal | tonumber? // 0),
        secure: (.security != "" and .security != "--"),
        sae: ((.security | test("WPA3")) and (.security | test("WPA2|WPA1") | not))
      })
    | group_by(.ssid) | map(max_by(.signal)) | sort_by(-.signal)'
}

# The Wi-Fi network the TV is on, or nothing. nmcli's terse lines are
# yes-or-no:name, with any colon in the name escaped.
current_wifi() {
  nmcli -t -f ACTIVE,SSID device wifi list --rescan no ifname "$1" 2>/dev/null |
    awk '!found && /^yes:/ { sub(/^yes:/, ""); print; found = 1 }' | sed 's/\\\(.\)/\1/g'
}

write_networks() {
  install -d -m 755 "$RUN"
  printf '%s\n' "${1:-[]}" >"$RUN/.networks.json.next"
  chmod 644 "$RUN/.networks.json.next"
  mv -f "$RUN/.networks.json.next" "$RUN/networks.json"
}

# A look at the networks nearby with the hotspot closed, for Settings: the
# list, and which one the TV is on. With the hotspot open the radio can't
# look, so the list from before it opened stays.
look() {
  local device

  device=$(wifi_device)
  if [[ -z $device ]]; then
    state_set '.radio = false | .wifi = null | .scanned = $at | .answered = $asked'
    return 0
  fi
  if [[ $(state_get .on) == "true" ]]; then
    state_set '.radio = true | .wifi = null | .scanned = $at | .answered = $asked'
    return 0
  fi
  nmcli radio wifi on >/dev/null 2>&1 || true
  write_networks "$(scan "$device")"
  state_set '.radio = true | .wifi = (if $wifi == "" then null else $wifi end) | .scanned = $at | .answered = $asked' --arg wifi "$(current_wifi "$device")"
}

# The holes the hotspot needs in Omarchy's firewall, on its own interface
# and nowhere else: DHCP and DNS for the phone, and the captive page, with
# port 80 sent to it. They go in ahead of ufw's own rules and come out by
# their tag, so a run that ended badly leaves nothing behind once the next
# one starts or stops.
firewall_open() {
  local device=$1 rule proto port
  for rule in "udp 67" "udp 53" "tcp 53" "tcp $PORT"; do
    read -r proto port <<<"$rule"
    iptables -I INPUT 1 -i "$device" -p "$proto" --dport "$port" -m comment --comment "$TAG" -j ACCEPT
  done
  iptables -t nat -A PREROUTING -i "$device" -p tcp --dport 80 -m comment --comment "$TAG" -j REDIRECT --to-ports "$PORT"
}

firewall_close() {
  local table rule parts
  for table in filter nat; do
    while rule=$(iptables -t "$table" -S 2>/dev/null | awk -v tag="--comment $TAG" '!found && index($0, tag) { print; found = 1 }') && [[ -n $rule ]]; do
      read -ra parts <<<"${rule/#-A /-D }"
      iptables -t "$table" "${parts[@]}" || break
    done
  done
}

run() {
  local device ssid password networks

  device=$(wifi_device)
  if [[ -z $device ]]; then
    state_set '.on = false | .error = "this box has no wi-fi"'
    echo "agentv-hotspot: NetworkManager has no Wi-Fi device" >&2
    exit 1
  fi
  nmcli radio wifi on >/dev/null 2>&1 || true
  firewall_close
  nmcli connection delete "$CONNECTION" >/dev/null 2>&1 || true

  networks=$(scan "$device")
  write_networks "$networks"

  # One name and password for the whole boot, so a phone that joined once
  # still knows it when the hotspot comes back after a wrong password. The
  # first time, the one the USB stick handed over, so the phone that set
  # the box up from there is already on it.
  ssid=$(state_get .ssid)
  password=$(state_get .password)
  if [[ $ssid != AgenTV-* || -z $password ]]; then
    read -r ssid password <<<"$(handed)" || true
  fi
  if [[ $ssid != AgenTV-* || -z $password ]]; then
    ssid="AgenTV-$(random 0123456789abcdef 4)"
    password=$(random abcdefghjkmnpqrstuvwxyz23456789 10)
  fi

  # Kept in memory only, so nothing of it is left after a restart.
  nmcli connection add save no type wifi ifname "$device" con-name "$CONNECTION" autoconnect no ssid "$ssid" \
    802-11-wireless.mode ap 802-11-wireless.band bg \
    wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp \
    wifi-sec.pmf disable wifi-sec.psk "$password" \
    ipv4.method manual ipv4.addresses "$ADDRESS/24" ipv6.method disabled >/dev/null
  if ! nmcli --wait 45 connection up "$CONNECTION" >/dev/null; then
    state_set '.on = false | .error = "the setup hotspot didn'"'"'t come up"'
    echo "agentv-hotspot: NetworkManager didn't bring up the hotspot; journalctl -u NetworkManager says why" >&2
    exit 1
  fi
  firewall_open "$device"
  state_set '.on = true | .ssid = $ssid | .password = $password | .device = $device | .address = $address | .joining = null | .joined = null | .wifi = null' \
    --arg ssid "$ssid" --arg password "$password" --arg device "$device" --arg address "$ADDRESS"
  echo "agentv-hotspot: $ssid is on, with the setup page at http://$ADDRESS/"

  # Addresses for phones, and every name pointing at the box, which is how
  # iOS and Android find out there's a page to open (RFC 8910 says so too).
  exec dnsmasq --keep-in-foreground --conf-file=/dev/null --no-resolv --no-hosts --no-poll \
    --interface="$device" --except-interface=lo --bind-interfaces \
    --dhcp-range="10.42.0.10,10.42.0.250,255.255.255.0,10m" --dhcp-authoritative \
    --dhcp-option=option:router,"$ADDRESS" --dhcp-option=option:dns-server,"$ADDRESS" \
    --dhcp-option=114,"http://$ADDRESS/" \
    --address="/#/$ADDRESS" --dhcp-leasefile="$RUN/dnsmasq.leases" --log-facility=-
}

down() {
  nmcli connection down "$CONNECTION" >/dev/null 2>&1 || true
  nmcli connection delete "$CONNECTION" >/dev/null 2>&1 || true
  firewall_close
  [[ -f $RUN/state.json ]] || return 0
  if [[ ${SERVICE_RESULT:-success} == "success" ]]; then
    state_set '.on = false'
  else
    state_set '.on = false | .error = (.error // "the setup hotspot stopped")'
  fi
}

# Only when TV setup isn't done, the box has Wi-Fi, and once NetworkManager
# has tried every connection it knows, none of them is up. Ethernet, or Wi-Fi
# set up in the installer, goes straight to pairing, unless a phone is
# waiting on the network the USB stick handed over.
boot() {
  if setup_done; then
    rm -f "$HANDED"
    return 0
  fi
  nm-online -q -s -t 60 || true
  [[ -n $(wifi_device) ]] || return 0
  if [[ -n $(handed) ]]; then
    echo "agentv-hotspot: setup isn't done and a phone set this box up from the USB stick, so its network opens again"
    systemctl start --no-block agentv-hotspot.service
    return 0
  fi
  nm-online -q -x -t 5 && return 0
  echo "agentv-hotspot: setup isn't done and there's no network, so the setup hotspot opens"
  systemctl start --no-block agentv-hotspot.service
}

# A value as NetworkManager's key files read it: a backslash and every
# space escaped, the way GLib's key files want them.
keyfile_string() {
  local value=${1//\\/\\\\}
  printf '%s' "${value// /\\s}"
}

# A network's name as the bytes it's made of, which NetworkManager reads
# whatever the name has in it.
keyfile_bytes() {
  printf '%s' "$1" | od -An -v -tu1 | tr -s ' \n' ';' | sed 's/^;//'
}

valid_ssid() {
  local LC_ALL=C
  [[ -n $1 && ${#1} -le 32 && ! $1 =~ [[:cntrl:]] ]]
}

valid_password() {
  local LC_ALL=C
  [[ -z $1 || $1 =~ ^[\ -~]{8,63}$ || $1 =~ ^[0-9a-fA-F]{64}$ ]]
}

# A join that ended before it said how it went, as when one of its commands
# failed: it says so now, and the hotspot it closed opens again. Left as
# "joining", the watch would keep out for good, every later join would be
# told the TV is busy, and Settings would say "Joining" until a restart.
JOIN_CLOSED_HOTSPOT=""
join_ended() {
  local ssid

  ssid=$(state_get .joining)
  [[ -n $ssid ]] || return 0
  echo "agentv-hotspot: the join of $ssid ended before it was done" >&2
  state_set '.joining = null | .error = $error | .why = "failed" | .answered = $asked' --arg error "the tv couldn't join $ssid" || true
  if [[ $JOIN_CLOSED_HOTSPOT == "true" ]]; then
    systemctl start --no-block agentv-hotspot.service || true
  fi
}

# join <ssid> <password> <hidden>: the home Wi-Fi, in place of the hotspot,
# or of the network the TV is on. When it doesn't work, the TV goes back to
# what it had: the hotspot if that was open, or else the network from before.
join() {
  local ssid=$1 password=$2 hidden=$3 device uuid file keymgmt=wpa-psk output address error why was_on previous="" old old_uuid

  device=$(state_get .device)
  [[ -n $device ]] || device=$(wifi_device)
  was_on=$(state_get .on)
  [[ $was_on == "true" ]] || previous=$(nmcli -g GENERAL.CON-UUID device show "$device" 2>/dev/null | head -n 1)
  JOIN_CLOSED_HOTSPOT=$was_on
  trap join_ended EXIT
  state_set '.joining = $ssid | .error = null | .why = null' --arg ssid "$ssid"
  systemctl stop agentv-hotspot.service

  [[ $(jq -r --arg ssid "$ssid" 'map(select(.ssid == $ssid))[0].sae // false' "$RUN/networks.json" 2>/dev/null) == "true" ]] && keymgmt=sae
  uuid=$(cat /proc/sys/kernel/random/uuid)
  file="$CONNECTIONS/agentv-${uuid%%-*}.nmconnection"
  install -d -m 700 "$CONNECTIONS"
  (
    umask 077
    printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\n\n[wifi]\nmode=infrastructure\nssid=%s\n' \
      "$(keyfile_string "$ssid")" "$uuid" "$(keyfile_bytes "$ssid")"
    [[ $hidden == "true" ]] && printf 'hidden=true\n'
    [[ -n $password ]] && printf '\n[wifi-security]\nkey-mgmt=%s\npsk=%s\n' "$keymgmt" "$(keyfile_string "$password")"
    printf '\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
  ) >"$file"
  chmod 600 "$file"

  if nmcli connection load "$file" >/dev/null 2>&1 && output=$(nmcli --wait 45 connection up uuid "$uuid" ifname "$device" 2>&1); then
    # What AgenTV kept for this network before goes, such as its password
    # from before the router got a new one.
    for old in "$CONNECTIONS"/agentv-*.nmconnection; do
      [[ -f $old && $old != "$file" ]] || continue
      grep -qxF "ssid=$(keyfile_bytes "$ssid")" "$old" || continue
      old_uuid=$(sed -n 's/^uuid=//p' "$old" | head -n 1)
      if [[ -n $old_uuid ]]; then
        nmcli connection delete uuid "$old_uuid" >/dev/null 2>&1 || true
      fi
      rm -f "$old"
    done
    address=$(nmcli -g IP4.ADDRESS device show "$device" 2>/dev/null | awk -F/ 'NR == 1 { print $1 }')
    state_set '.on = false | .joining = null | .joined = {ssid: $ssid, address: (if $address == "" then null else $address end)} | .wifi = $ssid | .error = null | .why = null | .watch = null | .answered = $asked' \
      --arg ssid "$ssid" --arg address "$address"
    echo "agentv-hotspot: the box is on $ssid${address:+ at $address}, and the setup hotspot is closed"
    return 0
  fi

  nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
  rm -f "$file"
  [[ -n ${output:-} ]] || output="NetworkManager wouldn't load it"
  case $output in
    *"Secrets were required"*)
      error="that password didn't work for $ssid"
      why=password
      ;;
    *"could not be found"* | *"No network with SSID"*)
      error="the tv can't see $ssid from here"
      why=missing
      ;;
    *)
      error="the tv couldn't join $ssid"
      why=failed
      ;;
  esac
  echo "agentv-hotspot: couldn't join $ssid: $output" >&2
  state_set '.joining = null | .error = $error | .why = $why | .answered = $asked' --arg error "$error" --arg why "$why"
  if [[ $was_on == "true" ]]; then
    systemctl start agentv-hotspot.service
  else
    # Back on the network from before. NetworkManager goes back by itself
    # too, and this doesn't wait for it to think of it.
    if [[ -n $previous ]]; then
      nmcli --wait 30 connection up uuid "$previous" ifname "$device" >/dev/null 2>&1 || true
    fi
    state_set '.wifi = (if $wifi == "" then null else $wifi end)' --arg wifi "$(current_wifi "$device")"
  fi
  return 1
}

# What the daemon handed over: the home Wi-Fi to join, a look at the
# networks nearby, or to close the hotspot as setup ends.
drop() {
  local request ssid password hidden

  [[ -f $DROP ]] || return 0
  request=$(cat "$DROP")
  rm -f "$DROP"
  ASKED=$(jq -r '.id // empty' <<<"$request" 2>/dev/null || true)
  [[ $ASKED =~ ^[0-9a-f]{1,32}$ ]] || ASKED=""
  if [[ $(jq -r '.scan // false' <<<"$request" 2>/dev/null) == "true" ]]; then
    look
    return 0
  fi
  if [[ $(jq -r '.stop // false' <<<"$request" 2>/dev/null) == "true" ]]; then
    rm -f "$HANDED"
    systemctl stop agentv-hotspot.service
    echo "agentv-hotspot: closed, as setup ended"
    return 0
  fi
  ssid=$(jq -r '.join.ssid // empty' <<<"$request" 2>/dev/null || true)
  password=$(jq -r '.join.password // empty' <<<"$request" 2>/dev/null || true)
  hidden=$(jq -r '.join.hidden // false' <<<"$request" 2>/dev/null || true)
  if ! valid_ssid "$ssid" || ! valid_password "$password"; then
    state_set '.error = "that isn'"'"'t a wi-fi network and password" | .answered = $asked'
    echo "agentv-hotspot: that isn't a Wi-Fi network's name and password; nothing changed" >&2
    return 1
  fi
  join "$ssid" "$password" "$hidden"
}

# --- A TV that lost its network ------------------------------------------------

# How the TV's links stand, into ONLINE (a cable or a Wi-Fi network that
# isn't its own hotspot is up), CABLE (a cable is in, up or not) and WIFI
# (it has Wi-Fi). nmcli's terse lines are device:type:state:connection.
links() {
  local device type state connection

  ONLINE=0 CABLE=0 WIFI=0
  while IFS=: read -r device type state connection; do
    [[ " $WATCH_SKIP " == *" $device "* ]] && continue
    case $type in
      ethernet)
        [[ $state == "unavailable" || $state == "unmanaged" ]] || CABLE=1
        ;;
      wifi) WIFI=1 ;;
      *) continue ;;
    esac
    [[ $state == connected* && $connection != "$CONNECTION" ]] && ONLINE=1
  done < <(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null || true)
  return 0
}

# Whether a phone is on the hotspot: the radio says who's joined, or without
# iw, dnsmasq's list of the addresses it handed out says who was.
phone_on() {
  local device

  device=$(state_get .device)
  if [[ -n $device ]] && type -P iw >/dev/null; then
    iw dev "$device" station dump 2>/dev/null | grep -q "^Station"
  else
    [[ -s $RUN/dnsmasq.leases ]]
  fi
}

knows_wifi() {
  nmcli -t -f TYPE,NAME connection show 2>/dev/null | grep -v ":$CONNECTION\$" | grep -q "^802-11-wireless:"
}

# One look at how things stand, and what to do about it. PAUSE is how long
# the next look can wait when nothing changes before.
#
# Only once setup is done, on a TV with Wi-Fi and no cable in. A minute with
# no network opens the hotspot, and the network coming back closes it. With
# the hotspot open, the radio can't see the home Wi-Fi come back, as it does
# after a router restarts. So every few minutes with no phone on it, the
# hotspot closes, the TV looks for the networks it knows, and the hotspot
# opens again only if none of them is there.
watch_tick() {
  local now since ours=false

  PAUSE=300
  setup_done || return 0
  # A join is root's own doing, and says how it went itself.
  if [[ -n $(state_get .joining) ]]; then
    PAUSE=5
    return 0
  fi
  now=$(date +%s)
  links
  [[ $(state_get .watch) == "true" ]] && ours=true

  if (( ONLINE )); then
    rm -f "$RUN/lost-since"
    if [[ $ours == "true" ]]; then
      echo "agentv-hotspot: the network is back, so the hotspot closes"
      systemctl stop agentv-hotspot.service
      state_set '.watch = null | .error = null | .why = null'
    fi
    return 0
  fi

  PAUSE=5
  if [[ $(state_get .on) == "true" ]]; then
    [[ $ours == "true" ]] || return 0
    [[ -s $RUN/opened-at ]] || echo "$now" >"$RUN/opened-at"
    since=$(cat "$RUN/opened-at")
    (( now - since >= RETRY_AFTER )) || return 0
    echo "$now" >"$RUN/opened-at"
    if phone_on || ! knows_wifi; then
      return 0
    fi
    echo "agentv-hotspot: nobody's on the hotspot, so it closes for a moment to look for the Wi-Fi this TV knows"
    systemctl stop agentv-hotspot.service
    nmcli -t -f SSID device wifi list --rescan yes ifname "$(state_get .device)" >/dev/null 2>&1 || true
    nmcli --wait "$REJOIN_WAIT" device connect "$(state_get .device)" >/dev/null 2>&1 || true
    links
    if (( ONLINE )); then
      echo "agentv-hotspot: the network is back, and the hotspot stays closed"
      state_set '.watch = null | .error = null | .why = null'
      rm -f "$RUN/lost-since"
      return 0
    fi
    systemctl start --no-block agentv-hotspot.service
    return 0
  fi

  # No network and no hotspot. A cable that's in is on its way up, and a TV
  # with no Wi-Fi has no hotspot to open.
  if (( CABLE || ! WIFI )); then
    rm -f "$RUN/lost-since"
    return 0
  fi
  # One that's opening says so itself in a moment.
  systemctl is-active --quiet agentv-hotspot.service && return 0
  install -d -m 755 "$RUN"
  if [[ ! -s $RUN/lost-since ]]; then
    echo "$now" >"$RUN/lost-since"
  fi
  since=$(cat "$RUN/lost-since")
  (( now - since >= LOST_AFTER )) || return 0
  echo "agentv-hotspot: no network for $(( now - since )) s, so the hotspot opens for a phone to pick one"
  rm -f "$RUN/lost-since"
  echo "$now" >"$RUN/opened-at"
  state_set '.watch = true | .error = null | .why = null'
  systemctl start --no-block agentv-hotspot.service
}

# Looks whenever NetworkManager says something changed, and every few
# seconds while there's no network.
watch() {
  local value fd

  for value in "$LOST_AFTER" "$RETRY_AFTER" "$REJOIN_WAIT"; do
    [[ $value =~ ^[0-9]+$ ]] || { echo "agentv-hotspot: the watch's waits are whole seconds" >&2; exit 1; }
  done
  PAUSE=5
  while true; do
    coproc MONITOR { exec nmcli monitor 2>/dev/null; }
    fd=${MONITOR[0]:-}
    # With no monitor to wait on, as while NetworkManager is down, it looks
    # every few seconds.
    while [[ -z $fd ]]; do
      watch_tick || true
      sleep 5
      coproc MONITOR { exec nmcli monitor 2>/dev/null; }
      fd=${MONITOR[0]:-}
    done
    while true; do
      watch_tick || true
      # A change wakes it, and what follows in the same second is one change.
      # read says more than 128 when the wait ran out, and less when the
      # monitor is gone.
      if read -r -t "$PAUSE" -u "$fd" _; then
        while read -r -t 1 -u "$fd" _; do :; done
      elif (( $? <= 128 )); then
        break
      fi
    done
    # NetworkManager's monitor went, as when it restarts: again in a moment.
    sleep 5
  done
}

status() {
  local on ssid password joined address error

  on=$(state_get .on)
  ssid=$(state_get .ssid)
  password=$(state_get .password)
  joined=$(state_get .joined.ssid)
  address=$(state_get .joined.address)
  error=$(state_get .error)
  if [[ $on == "true" ]]; then
    echo "The setup hotspot is on: $ssid, password $password. Phones that join get the setup page at http://$ADDRESS/."
  elif [[ -n $(state_get .joining) ]]; then
    echo "The box is joining $(state_get .joining)."
  elif [[ -n $joined ]]; then
    echo "The setup hotspot is closed. The box joined $joined${address:+ at $address}."
  else
    echo "The setup hotspot is off."
  fi
  [[ -n $error ]] && echo "The last try said: $error."
  return 0
}

as_root() {
  if (( EUID == 0 )); then
    "$@"
  else
    sudo "$@"
  fi
}

case "${1:-}" in
  start)
    as_root systemctl start agentv-hotspot.service
    for _ in $(seq 1 60); do
      [[ $(state_get .on) == "true" ]] && break
      systemctl is-active --quiet agentv-hotspot.service || break
      sleep 1
    done
    status
    ;;
  stop)
    as_root systemctl stop agentv-hotspot.service
    status
    ;;
  status) status ;;
  run) run ;;
  down) down ;;
  boot) boot ;;
  drop) drop ;;
  watch) watch ;;
  watch-tick) watch_tick ;;
  *)
    echo "Usage: agentv hotspot start|stop|status" >&2
    exit 1
    ;;
esac
