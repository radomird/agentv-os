#!/bin/bash

# origaitv:summary=List the apps on this TV

# One line per app: its id, its version and where it came from (its tier).

set -euo pipefail

ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}
ORIGAITV_STATE=${ORIGAITV_STATE:-/var/lib/origaitv}

# Node 22.6 to 22.17 runs TypeScript only when asked.
flags=()
[[ -n $(node -p 'process.features.typescript || ""' 2>/dev/null) ]] || flags+=(--experimental-strip-types)

export ORIGAITV_PATH ORIGAITV_STATE
exec node ${flags[@]+"${flags[@]}"} --disable-warning=ExperimentalWarning "$ORIGAITV_PATH/daemon/apps/cli.ts" list "$@"
