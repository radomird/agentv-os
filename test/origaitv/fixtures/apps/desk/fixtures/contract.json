{
  "routes": [
    { "url": "https://desk.test/desktop.html", "file": "pages/desktop.html" },
    { "url": "https://desk.test/next.html", "file": "pages/next.html" },
    { "url": "https://desk.test/own-keys.html", "file": "pages/own-keys.html" },
    { "url": "https://desk.test/rows.html", "file": "pages/rows.html" },
    { "url": "https://desk.test/inner.html", "file": "pages/inner.html" }
  ],
  "checks": [
    { "name": "launch opens its site", "page": "https://desk.test/next.html", "call": "launch", "after": { "url": "^https://desk\\.test/desktop\\.html$" } },
    { "name": "the d-pad's first press lands on the biggest thing in view, the title nearest the middle", "page": "https://desk.test/desktop.html", "remote": ["down"], "after": { "focused": "^Title 3$" } },
    { "name": "left goes back along the row to its first title", "page": "https://desk.test/desktop.html", "remote": ["down", "left", "left"], "after": { "focused": "^Title 1$" } },
    { "name": "right goes along the row, past the edge of the screen", "page": "https://desk.test/desktop.html", "remote": ["down", "right", "right", "right", "right", "right"], "after": { "focused": "^Title 8$" } },
    { "name": "OK presses the title that has focus", "page": "https://desk.test/desktop.html", "remote": ["down", "right", "enter"], "after": { "focused": "^Title 4$", "title": "^picked 4$" } },
    { "name": "up from the row reaches the links along the top, and OK opens one", "page": "https://desk.test/desktop.html", "remote": ["down", "up", "enter"], "after": { "url": "/next\\.html\\?(films|series)$" } },
    { "name": "and Back goes back a page", "remote": ["back"], "after": { "url": "/desktop\\.html$" } },
    { "name": "a page that moves its own focus with the arrows keeps them", "page": "https://desk.test/own-keys.html", "remote": ["right"], "after": { "title": "^on 2$", "focused": "^$" } },
    { "id": "T21.1", "name": "the d-pad's first press lands on the banner, the biggest thing in view", "page": "https://desk.test/rows.html", "remote": ["down"], "after": { "focused": "^Tonight's film$" } },
    { "id": "T21.1", "name": "the d-pad reaches the last row of a page with cards that can't take focus and rows that load as it scrolls", "page": "https://desk.test/rows.html", "remote": ["down", "down", "down", "down", "down", "down", "down", "down", "down", "down", "down", "down", "down", "down"], "after": { "focused": "^Row 10 title 3$" } },
    { "id": "T21.1", "name": "right goes along that row past the edge of the screen", "remote": ["right", "right", "right", "right", "right", "right", "right", "right", "right", "right", "right", "right", "right", "right"], "after": { "focused": "^Row 10 title 15$" } },
    { "id": "T21.1", "name": "OK presses a card that can't take focus of its own", "remote": ["enter"], "after": { "title": "^picked 10-15$" } },
    { "id": "T21.1", "name": "with its app's hint, right slides a row by the row's own button and lands on what comes into sight", "page": "https://desk.test/rows.html", "remote": ["down", "down", "down", "right", "right", "right", "right", "right"], "after": { "focused": "^Row 2 title 8$" } },
    { "id": "T21.1", "name": "the d-pad keeps to a page's own scroll area, down to its last row", "page": "https://desk.test/inner.html", "remote": ["down", "down", "down", "down", "down", "down", "down", "down", "down", "down"], "after": { "focused": "^Row 8 title 2$" } }
  ]
}
