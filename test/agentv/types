#!/bin/bash

# Type-checks AgenTV's TypeScript (ADR-019, layer 1): the daemon and its
# tests, with TypeScript and Node's types at pinned versions, fetched into a
# folder of their own. The box itself never needs them: Node runs the
# TypeScript as it is.
#
# Usage: test/agentv/types

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
TYPESCRIPT=typescript@5.9.3
NODE_TYPES=@types/node@24.10.1

tools=$(mktemp -d)
trap 'rm -rf "$tools"' EXIT

npm install --prefix "$tools" --no-save --no-audit --no-fund --silent "$TYPESCRIPT" "$NODE_TYPES"
"$tools/node_modules/.bin/tsc" -p "$ROOT/daemon/tsconfig.json" --typeRoots "$tools/node_modules/@types"
echo "ok - the daemon's TypeScript type-checks ($TYPESCRIPT, $NODE_TYPES)"
