#!/bin/bash

# Runs Omarchy's own CLI and shell suites at the base tag and at HEAD, one
# file at a time, and fails when a file that passes at the base fails here.
# AgenTV only adds files, so a new failure means something of ours leaked into
# Omarchy's world, such as a command in bin/ that one of its scans picks up.
# Comparing with the base keeps a test that needs a desktop (and so can't pass
# in CI either way) from hiding the ones that can.

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

base=$(sed -n '1{s/[[:space:]]//g;p;}' .github/omarchy-base)
WORK=$(mktemp -d)
trap 'git worktree remove --force "$WORK/base" >/dev/null 2>&1 || true; rm -rf "$WORK"' EXIT

git worktree add --quiet --detach "$WORK/base" "$base^{commit}"

# run_suites <tree> <results file>: one "pass|fail <name>" line per test file.
run_suites() {
  local tree="$1" results="$2" test name

  : >"$results"
  for test in "$tree/test/cli" "$tree"/test/shell.d/*-test.sh; do
    name=${test#"$tree"/}
    [[ $name == "test/shell.d/base-test.sh" ]] && continue
    if (cd "$tree" && timeout 120 bash "$test" >"$WORK/last.log" 2>&1); then
      printf 'pass %s\n' "$name" >>"$results"
    else
      printf 'fail %s\n' "$name" >>"$results"
      cp "$WORK/last.log" "$WORK/$(basename "$results").$(basename "$name").log"
    fi
  done
}

printf '==> Omarchy %s\n' "$base"
run_suites "$WORK/base" "$WORK/base-results"
printf '==> HEAD\n'
run_suites "$ROOT" "$WORK/head-results"

total=$(grep -c . "$WORK/head-results")
base_failing=$(grep -c '^fail ' "$WORK/base-results" || true)

regressions=()
while read -r status name; do
  [[ $status == "fail" ]] || continue
  if grep -qxF "pass $name" "$WORK/base-results"; then
    regressions+=("$name")
  fi
done <"$WORK/head-results"

if (( ${#regressions[@]} > 0 )); then
  printf 'not ok - Omarchy test files that pass at %s fail here:\n' "$base" >&2
  for name in "${regressions[@]}"; do
    printf '\n--- %s\n' "$name" >&2
    tail -n 40 "$WORK/head-results.$(basename "$name").log" >&2 || true
  done
  exit 1
fi

printf "ok - Omarchy's own tests: %d files, none worse than at %s (%d fail there too, without a desktop)\n" \
  "$total" "$base" "$base_failing"
