#!/usr/bin/env python3
"""Swaps every id a throwaway server made up for a plain, numbered one, in
every recording in a folder: UUIDs like Immich's. The same id gets the same
number everywhere, in replies and in request paths alike, so the recordings
still agree with each other. They read better, say nothing about the server
they came from, and don't look like keys to a secret scanner. (agentv-apps
has the same, for its apps' recordings.)

Usage: test/agentv/fixtures/record/stable-ids <folder>
"""

import json
import re
import sys
from pathlib import Path

UUID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")

folder = Path(sys.argv[1])
files = sorted(folder.glob("*.json"))
seen: dict[str, str] = {}


def number(match: re.Match) -> str:
    key = match.group(0).lower().replace("-", "")
    if key not in seen:
        seen[key] = f"{len(seen) + 1:032x}"
    plain = seen[key]
    return f"{plain[:8]}-{plain[8:12]}-{plain[12:16]}-{plain[16:20]}-{plain[20:]}"


for path in files:
    text = UUID.sub(number, path.read_text())
    json.loads(text)
    path.write_text(text)
print(f"{len(seen)} ids made plain in {len(files)} recordings")
