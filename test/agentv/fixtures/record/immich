#!/bin/bash

# Records Immich's replies, from its official container images, as fixtures
# for the Immich app's contract tests (ADR-019 layer 3, S3.1). Immich's own
# docker-compose.yml for a pinned release runs the server, its database and
# its cache; machine learning stays off. A throwaway admin gets three photos
# made here with ffmpeg, so they're ours to give away, and an album of two.
# Then each request a TV app makes is recorded with its reply, in
# test/agentv/fixtures/immich/<name>.json as { request, status, headers,
# body }, and a photo's preview as a .jpg beside it. The access token is
# replaced with "fixture-token", and every id it made up with a plain
# numbered one (stable-ids).
#
# Usage: test/agentv/fixtures/record/immich   (needs docker compose, ffmpeg, curl, jq)

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
DIR="$ROOT/test/agentv/fixtures/immich"
VERSION=${AGENTV_IMMICH_VERSION:-v2.0.0}
PORT=${AGENTV_IMMICH_PORT:-12283}
BASE="http://127.0.0.1:$PORT"
EMAIL=viewer@fixtures.test
PASSWORD=fixture-password

work=$(mktemp -d)
project="agentv-immich-$$"
cleanup() {
  (cd "$work" && docker compose -p "$project" down -v >/dev/null 2>&1) || true
  # The containers' files are root's.
  sudo -n rm -rf "$work" 2>/dev/null || rm -rf "$work" 2>/dev/null || true
}
trap cleanup EXIT

cd "$work"
curl -fsSL -o docker-compose.yml "https://github.com/immich-app/immich/releases/download/$VERSION/docker-compose.yml"
curl -fsSL -o .env "https://github.com/immich-app/immich/releases/download/$VERSION/example.env"
mkdir -p library postgres
{
  echo "IMMICH_VERSION=$VERSION"
  echo "UPLOAD_LOCATION=$work/library"
  echo "DB_DATA_LOCATION=$work/postgres"
  echo "DB_PASSWORD=fixtures"
} >>.env
# Only on this machine's loopback, on a port of its own.
sed -i "s/- '\?2283:2283'\?/- '127.0.0.1:$PORT:2283'/" docker-compose.yml
grep -q "127.0.0.1:$PORT:2283" docker-compose.yml || { echo "couldn't move Immich to port $PORT" >&2; exit 1; }
services=$(docker compose config --services | grep -v machine-learning | tr '\n' ' ')
# shellcheck disable=SC2086 # a list of services
docker compose -p "$project" up -d $services >/dev/null

for _ in $(seq 1 180); do
  [[ $(curl -fsS "$BASE/api/server/ping" 2>/dev/null | jq -r .res 2>/dev/null) == "pong" ]] && break
  sleep 1
done
[[ $(curl -fsS "$BASE/api/server/ping" 2>/dev/null | jq -r .res 2>/dev/null) == "pong" ]] ||
  { docker compose -p "$project" logs --tail 40 >&2; echo "Immich never came up" >&2; exit 1; }

token=""
api() {
  curl -fsS -X "$1" "$BASE$2" ${token:+-H "Authorization: Bearer $token"} -H "Content-Type: application/json" ${3:+--data "$3"}
}

# record <name> <method> <path> [json body]: one request and its reply, kept.
# A reply that isn't JSON, a picture, goes to <name>.<ext> beside it.
record() {
  local status type file=""
  status=$(curl -sS -X "$2" "$BASE$3" ${token:+-H "Authorization: Bearer $token"} -H "Content-Type: application/json" ${4:+--data "$4"} \
    -o "$work/body" -D "$work/headers" -w '%{http_code}')
  [[ $status == 2* ]] || { echo "Immich answered $status for $2 $3" >&2; cat "$work/body" >&2; exit 1; }
  type=$(tr -d '\r' <"$work/headers" | sed -n 's/^content-type: //Ip' | tail -n 1)
  if [[ $type != application/json* ]]; then
    file="$1.${type#image/}"
    file=${file%%;*}
    cp "$work/body" "$DIR/$file"
    echo 'null' >"$work/body"
  fi
  jq -n --arg method "$2" --arg path "$3" --arg body "${4:-}" --argjson status "$status" --arg type "$type" --arg file "$file" \
    --arg token "$token" --slurpfile reply "$work/body" '
      ($reply[0] | walk(if type == "string" and $token != "" and . == $token then "fixture-token" else . end)) as $clean
      | {request: ({method: $method, path: $path} + (if $body == "" then {} else {body: ($body | fromjson)} end)),
         status: $status, headers: {"content-type": $type}}
        + (if $file == "" then {body: $clean} else {file: $file} end)' >"$DIR/$1.json"
  echo "recorded $1: $2 $3 ($status)"
}

api POST /api/auth/admin-sign-up "{\"email\":\"$EMAIL\",\"password\":\"$PASSWORD\",\"name\":\"Viewer\"}" >/dev/null
record login POST /api/auth/login "{\"email\":\"$EMAIL\",\"password\":\"$PASSWORD\"}"
token=$(jq -r .body.accessToken "$DIR/login.json")
jq --arg token "$token" 'walk(if type == "string" and . == $token then "fixture-token" else . end)' "$DIR/login.json" >"$work/l"
mv "$work/l" "$DIR/login.json"

# Three photos, made here, uploaded the way a phone's app does.
ids=()
for n in 1 2 3; do
  ffmpeg -loglevel error -y -f lavfi -i "testsrc=size=640x480" -vf "hue=h=$((n * 100))" -frames:v 1 "$work/photo-$n.jpg"
  id=$(curl -fsS -X POST "$BASE/api/assets" -H "Authorization: Bearer $token" \
    -F "assetData=@$work/photo-$n.jpg" -F "deviceAssetId=fixture-$n" -F "deviceId=agentv-fixtures" \
    -F "fileCreatedAt=2026-10-2${n}T18:00:00.000Z" -F "fileModifiedAt=2026-10-2${n}T18:00:00.000Z" | jq -r .id)
  ids+=("$id")
done
album=$(api POST /api/albums "{\"albumName\":\"Autumn\",\"assetIds\":[\"${ids[0]}\",\"${ids[1]}\"]}" | jq -r .id)
# Immich makes each photo's thumbnails in the background after the upload.
for _ in $(seq 1 120); do
  [[ $(curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $token" "$BASE/api/assets/${ids[0]}/thumbnail?size=preview") == 200 ]] && break
  sleep 1
done

record server-version GET /api/server/version
record users-me GET /api/users/me
record albums GET /api/albums
record album GET "/api/albums/$album"
record asset GET "/api/assets/${ids[0]}"
record search POST /api/search/metadata '{"page":1,"size":20}'
record preview GET "/api/assets/${ids[0]}/thumbnail?size=preview"

jq -n --arg version "$VERSION" --arg recorded "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg album "$album" --args '{version: $version, recorded: $recorded, album: $album, assets: $ARGS.positional}' "${ids[@]}" \
  >"$DIR/recording.json"
"$ROOT/test/agentv/fixtures/record/stable-ids" "$DIR"
echo "recorded Immich $VERSION"
