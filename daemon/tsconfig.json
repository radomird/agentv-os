{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "apps/*.ts", "../apps/contract/*.ts", "../apps/builtin/*/*.ts", "../test/agentv/unit/*.mts", "../test/agentv/ui/*.mts", "../test/agentv/contract/*.mts", "../test/agentv/fixtures/apps/*/*.ts"]
}
