  "include": ["*.ts", "apps/*.ts", "providers/*.ts", "executors/*.ts", "routes/*.ts", "../apps/contract/*.ts", "../apps/builtin/*/*.ts", "../test/origaitv/unit/*.mts", "../test/origaitv/ui/*.mts", "../test/origaitv/contract/*.mts", "../test/origaitv/evals/*/*.ts", "../test/origaitv/evals/*/*.mts", "../test/origaitv/fixtures/apps/*/*.ts"]
}
