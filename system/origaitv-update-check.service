# Looks for a new OrigaiTV, Omarchy and system packages for Settings → Updates
# (ADR-025): bin/origaitv-update-check. Its timer runs it once a day and a few
# minutes after boot, and Check now on the TV starts it too. It only looks.

[Unit]
Description=OrigaiTV update check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/origaitv-update-check
