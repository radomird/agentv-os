# Hands a newly installed box over to TV setup (ADR-007), once, before the
# login screen starts: OrigaiTV's repository line, autologin for the owner,
# OrigaiTV's hooks in the owner's Omarchy config, and the folders setup uses.
# Omarchy's installer questions have all run by now, unchanged.

[Unit]
Description=OrigaiTV first boot
ConditionPathExists=!/var/lib/origaitv/firstboot.done
After=local-fs.target systemd-sysusers.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/origaitv-firstboot

[Install]
WantedBy=multi-user.target
