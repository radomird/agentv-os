// AgenTV (ADR-060): the TV session tells Plymouth it has the screen, by
// starting agentv-boot-splash-release.service as the box's owner. It runs
// from the TV session's own Hyprland, which isn't part of a login session's
// processes, so, as for the update units, the rule goes by the owner's admin
// group (wheel), and allows starting that one unit and nothing else.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "agentv-boot-splash-release.service" &&
      action.lookup("verb") == "start" &&
      subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
