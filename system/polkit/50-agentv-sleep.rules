// AgenTV (ADR-072): with Settings → Power's sleep on, the TV's screen daemon
// suspends the box once the TV has been off for an hour, and first sets or
// clears the wake alarm for the night's update window, agentv-wake.timer.
// It runs as the box's owner, from the TV session's own systemd, which isn't
// part of a login session, so the rule can't ask for an active one.
// Both go by the owner's own account, the one SDDM logs in to the TV session
// (agentv-session-setup writes it), not by every admin, since nothing can
// wake a sleeping box from the phone. It never lets a suspend past an
// inhibitor that blocks sleep, such as a build, an update or a download:
// suspend-ignore-inhibit isn't here.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.login1.suspend" ||
      action.id == "org.freedesktop.login1.suspend-multiple-sessions" ||
      (action.id == "org.freedesktop.systemd1.manage-units" &&
       (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
       action.lookup("unit") == "agentv-wake.timer")) {
    var owner = "";
    try {
      owner = polkit.spawn(["/usr/bin/sed", "-n", "s/^User=//p", "/etc/sddm.conf.d/zz-agentv-autologin.conf"]).trim();
    } catch (error) {
      return;
    }
    if (owner != "" && subject.user == owner) {
      return polkit.Result.YES;
    }
  }
});
