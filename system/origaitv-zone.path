# The box's time zone, handed over by origaiTV's daemon when its country
# changes in TV setup or Settings (ADR-055): origaitv-zone.service sets it as
# root.

[Unit]
Description=origaiTV time zone hand-over

[Path]
PathExists=/var/lib/origaitv/daemon/zone-drop/zone.json
Unit=origaitv-zone.service

[Install]
WantedBy=paths.target
