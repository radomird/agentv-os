# AgenTV's daemon (daemon/server.ts): the TV's pages and the state behind
# them, on this box only for now. Node runs its TypeScript as it is. Its own
# state, such as whether setup is done, lives in /var/lib/agentv/daemon.

[Unit]
Description=AgenTV daemon
After=network.target

[Service]
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/agentv/daemon/server.ts --port 3000
Environment=AGENTV_PATH=/usr/share/agentv
Environment=AGENTV_DAEMON_STATE=/var/lib/agentv/daemon
StateDirectory=agentv/daemon
Restart=on-failure
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
