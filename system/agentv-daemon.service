# AgenTV's daemon (daemon/server.ts): the TV's pages and the state behind
# them on this box, the phone companion on the home network (port 3001) and
# the setup hotspot's captive page (port 3002). Node runs its TypeScript as
# it is. Its own state, such as whether setup is done, lives in
# /var/lib/agentv/daemon, the backgrounds with their credits in
# /var/lib/agentv/backgrounds, and what phones shared to the TV in
# /var/lib/agentv/shared. What's said to the TV goes to the router
# (agentv-router.service, agentv-router-cli.service), which only the
# agentv-router group reaches. Only the agentv-account group reaches
# agentv-password.socket, which sets the desktop account's password. The
# agentv-builder group reads the builds (their status and screenshot), which
# aren't for every user on the box.

[Unit]
Description=AgenTV daemon
After=network.target
Wants=agentv-router.service agentv-router-cli.service

[Service]
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/agentv/daemon/server.ts --port 3000
Environment=AGENTV_PATH=/usr/share/agentv
Environment=AGENTV_DAEMON_STATE=/var/lib/agentv/daemon
StateDirectory=agentv/daemon agentv/backgrounds agentv/shared
Restart=on-failure
# Stopped within a few seconds, so Restart and Shut down never wait on it
# (ADR-033).
TimeoutStopSec=5s
DynamicUser=yes
SupplementaryGroups=agentv-router agentv-account agentv-builder
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# It faces the home network and runs apps' workers, so it gets no more of
# the kernel than it uses: nothing to set under /proc/sys or /sys, no
# modules, no kernel log, no hostname to set, no other user's processes in
# /proc, and only the sockets it opens (netlink is how Node lists the box's
# addresses).
# Left out on purpose: PrivateDevices= and ProtectClock=, since the box
# check asks the GPU what it decodes through /dev/dri, and both close the
# unit's devices to a short list (ProtectClock= by its own DeviceAllow=);
# RestrictNamespaces= and PrivateUsers=, since an app's worker gets
# namespaces of its own; and MemoryDenyWriteExecute= and a
# SystemCallFilter=, which Node's JIT and the tools the daemon runs would
# need tuning for.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
