# The router with the household's key (daemon/router-serve.ts, ADR-013,
# ADR-023): one sentence from the daemon at a time, routed by the provider's
# API with structured output. Only this service reads the key, as a
# credential systemd hands it from /etc/agentv/env, so the daemon never
# holds it. agentv-key.service restarts it after a key is kept.
#
# Its sockets are in /run/agentv-router, for the agentv-router group only:
# router.sock for the daemon, and cli-net.sock, the plan's CLI's only way
# out (agentv-router-cli.service), its providers' own hosts on 443.

[Unit]
Description=AgenTV router
After=network.target

[Service]
User=agentv-router
Group=agentv-router
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/agentv/daemon/router-serve.ts api
Environment=AGENTV_PATH=/usr/share/agentv
LoadCredential=env:/etc/agentv/env
RuntimeDirectory=agentv-router
RuntimeDirectoryMode=0750
Restart=on-failure
TimeoutStopSec=5s
UMask=0077
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/agentv/chromium -/var/lib/agentv/builder -/var/lib/private
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
MemoryMax=512M

[Install]
WantedBy=multi-user.target
