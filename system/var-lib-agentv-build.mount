# The builds, mounted on themselves nosuid and nodev for the whole box
# (ADR-052, S6.10). A build's unit binds its own folder from here, so in the
# builder's sandbox too a set-user-ID or set-group-ID bit, or a device file,
# in a build gives no one more rights. agentv-builder@ waits for it.

[Unit]
Description=AgenTV's builds, where set-user-ID bits and devices do nothing

[Mount]
What=/var/lib/agentv/build
Where=/var/lib/agentv/build
Type=none
Options=bind,nosuid,nodev

[Install]
WantedBy=local-fs.target
