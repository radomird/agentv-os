# The builder's way out (builder/sandbox/net.ts, ADR-045), outside its
# sandbox, on two socket files only the builder's group can reach:
# proxy.sock, the filter that lets a build reach the npm registry, OSV.dev,
# the origins its app declares and, on a plan, its provider, and
# relay.sock, the relay that adds the household's key and keeps each build
# and the month inside their spend caps. The key comes as a credential, so
# only this service reads it, and the spend is kept in
# /var/lib/origaitv/spend for the TV. origaitv-build.service restarts this for
# each build.

[Unit]
Description=OrigaiTV builder's way out
After=network.target

[Service]
Type=notify
NotifyAccess=all
User=origaitv-build-net
Group=origaitv-build-net
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/origaitv/builder/sandbox/net.ts
Environment=ORIGAITV_PATH=/usr/share/origaitv
LoadCredential=env:/etc/origaitv/env
RuntimeDirectory=origaitv-build-net
RuntimeDirectoryMode=0750
StateDirectory=origaitv/spend
StateDirectoryMode=0755
Restart=on-failure
TimeoutStopSec=5s
UMask=0022
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/origaitv/chromium -/var/lib/origaitv/daemon -/var/lib/private
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# Netlink is how Node lists the box's own addresses, which the filter reads
# before each connection so it never connects back to this box.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
