# AgenTV's virtual input device (daemon/input.py, ADR-008): the phone's
# d-pad and keyboard reach every window on the TV through it.

[Unit]
Description=AgenTV virtual input device
PartOf=agentv-tv.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /usr/share/agentv/daemon/input.py serve
Restart=on-failure
RestartSec=2
# Stopped within a few seconds, so Restart and Shut down never wait on it
# (ADR-033).
TimeoutStopSec=5s
