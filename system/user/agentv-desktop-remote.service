# The phone's trackpad and keys on Omarchy's desktop (daemon/desktop-remote.ts,
# ADR-037). Omarchy's post-boot hook starts it with the virtual input device
# (bin/agentv-desktop-hook), and it stops with the desktop's session.

[Unit]
Description=AgenTV phone remote on Omarchy's desktop
PartOf=graphical-session.target
After=agentv-input.service

[Service]
ExecStart=/usr/bin/node /usr/share/agentv/daemon/desktop-remote.ts
Restart=on-failure
RestartSec=2
TimeoutStopSec=5s
