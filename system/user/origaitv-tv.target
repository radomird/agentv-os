# origaiTV's TV session (ADR-031). The session's Hyprland starts it once it's
# up (session/hypr.lua), and bin/origaitv-session stops it when the session
# ends. It takes the place of graphical-session.target, which the TV session
# never starts, because Omarchy's desktop services hang off that one.

[Unit]
Description=origaiTV's TV session
Wants=origaitv-screen.service origaitv-input.service origaitv-toast.service origaitv-theme.service
