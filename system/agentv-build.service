# Root's side of a build (builder/sandbox/hand-over.ts): checks what the
# daemon asked, makes the build's folder and the ticket the builder's way
# out goes by, fetches the provider's CLI into the builder's home the first
# time, and starts the build in its sandbox. agentv-build.path starts it.

[Unit]
Description=AgenTV build start

[Service]
Type=oneshot
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/agentv/builder/sandbox/hand-over.ts
Environment=AGENTV_PATH=/usr/share/agentv
# The first fetch of a CLI can take a while on a slow line.
TimeoutStartSec=25min
UMask=0022
ProtectSystem=strict
ReadWritePaths=/var/lib/agentv/build /run/agentv-build -/var/lib/private/agentv/daemon/build-drop
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
