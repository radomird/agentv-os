# Go back after an update (ADR-025): bin/origaitv-go-back puts the box back the
# way it was before the last update from the TV, from its snapshot, and
# restarts it. Started from the TV session through polkit
# (system/polkit/50-origaitv-update.rules), never enabled.

[Unit]
Description=origaiTV going back to the version before the update

[Service]
Type=oneshot
ExecStart=/usr/bin/origaitv-go-back
TimeoutStartSec=30min
