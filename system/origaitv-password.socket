# The desktop password's way to root (bin/origaitv-password-set). origaiTV's
# daemon is the only one in origaitv-account, so only it can connect. Each
# connection starts origaitv-password@.service with it as stdin and stdout, so
# the password goes from the daemon to chpasswd without a file.

[Unit]
Description=origaiTV desktop password hand-over

[Socket]
ListenStream=/run/origaitv-password.sock
SocketUser=root
SocketGroup=origaitv-account
SocketMode=0660
Accept=yes
MaxConnections=1

[Install]
WantedBy=sockets.target
