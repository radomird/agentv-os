# Sets the desktop account's password the TV was given (bin/agentv-password-set),
# one connection on agentv-password.socket at a time. It writes /etc/shadow
# through chpasswd, the account note in /var/lib/agentv and SSH's drop-in,
# and asks the daemon on 127.0.0.1 whether the PIN allowed it.

[Unit]
Description=AgenTV desktop password
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/bin/agentv-password-set
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
ProtectSystem=yes
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=30s
