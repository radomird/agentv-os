# A plan's sign-in, the first time the builder runs on it (ADR-022,
# ADR-040): the instance is the provider, like claude. The provider's own
# CLI signs in as agentv-builder, in the same sandbox as a build
# (agentv-builder@.service), and keeps what it gets in its own files in the
# builder's home. AgenTV shows the link it prints and types the code the
# person pastes on the phone into its prompt (builder/sign-in.ts), and sees
# nothing else. agentv-build.service starts this once root has made its
# folder and the filter's sign-in ticket.

[Unit]
Description=AgenTV builder's %i sign-in
BindsTo=agentv-build-net.service
After=agentv-build-net.service

[Service]
Type=exec
User=agentv-builder
Group=agentv-builder
SupplementaryGroups=agentv-build-net
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/agentv/builder/sign-in.ts %i
ExecStopPost=+/usr/bin/rm -f /run/agentv-build/sign-in.json
Environment=AGENTV_PATH=/usr/share/agentv HOME=/var/lib/agentv/builder AGENTV_SIGN_IN=/run/agentv-build/sign-in
WorkingDirectory=/var/lib/agentv/builder
# The person has 15 minutes; this is the box's own stop.
RuntimeMaxSec=20min
TimeoutStopSec=10s
UMask=0022
MemoryMax=1G
TasksMax=128
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/var/lib:ro
BindPaths=/var/lib/agentv/builder /run/agentv-build/sign-in
InaccessiblePaths=-/etc/agentv -/mnt -/media -/srv
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
