# Root's side of a build (builder/sandbox/hand-over.ts): checks what the
# daemon asked, makes the build's folder and the ticket the builder's way
# out goes by, fetches the provider's CLI into the builder's home the first
# time, and starts the build in its sandbox. It also installs an app an
# adult approved, puts the version before back, and removes an app the
# builder made, and the same for a theme. origaitv-build.path starts it.

[Unit]
Description=origaiTV build start

[Service]
Type=oneshot
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /usr/share/origaitv/builder/sandbox/hand-over.ts
Environment=ORIGAITV_PATH=/usr/share/origaitv
# The first fetch of a CLI can take a while on a slow line.
TimeoutStartSec=25min
UMask=0022
ProtectSystem=strict
ReadWritePaths=/var/lib/origaitv/build -/var/lib/origaitv/apps -/var/lib/origaitv/themes /run/origaitv-build -/var/lib/origaitv/daemon/build-drop
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
