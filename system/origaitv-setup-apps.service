# Installs the official apps picked in TV setup, or added from Apps, from
# the signed index, one after the other (bin/origaitv-setup-apps).
# origaitv-setup-apps.path starts it. It writes only the apps folder, its own
# status in /run and the daemon's drop, and fetches each app's exact commit
# over https. A native app's program, such as Steam, comes from
# origaitv-app-package@.service, which it starts and waits for (ADR-042).

[Unit]
Description=OrigaiTV setup's apps

[Service]
Type=oneshot
# Held awake while it runs: with Settings → Power's sleep on, the box never
# suspends in the middle of a download (ADR-072). That covers a native app's
# program too, which it waits for.
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=OrigaiTV "--why=installing apps" --mode=block /usr/bin/origaitv-setup-apps
# No limit for the whole queue, which can be every game platform: each step
# has its own (bin/origaitv-setup-apps, and the program's and the driver's
# units), and the daemon shows a line that's gone on longer than its step
# may take as not installed.
TimeoutStartSec=infinity
StateDirectory=origaitv/apps
StateDirectoryMode=0755
RuntimeDirectory=origaitv-setup-apps
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/origaitv/daemon
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
