# Sets the desktop account's password the TV was given (bin/origaitv-password-set),
# one connection on origaitv-password.socket at a time. It writes /etc/shadow
# through chpasswd, the account note in /var/lib/origaitv and SSH's drop-in,
# and asks the daemon on 127.0.0.1 whether the PIN allowed it.

[Unit]
Description=origaiTV desktop password
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/bin/origaitv-password-set
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
ProtectSystem=yes
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=30s
