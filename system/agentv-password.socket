# The desktop password's way to root (bin/agentv-password-set). AgenTV's
# daemon is the only one in agentv-account, so only it can connect. Each
# connection starts agentv-password@.service with it as stdin and stdout, so
# the password goes from the daemon to chpasswd without a file.

[Unit]
Description=AgenTV desktop password hand-over

[Socket]
ListenStream=/run/agentv-password.sock
SocketUser=root
SocketGroup=agentv-account
SocketMode=0660
Accept=yes
MaxConnections=1

[Install]
WantedBy=sockets.target
