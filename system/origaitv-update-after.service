# The check after an update that needed a restart (ADR-025): origaitv-update-tv
# leaves /var/lib/origaitv/update/check-pending, and bin/origaitv-update-after
# checks the box once it's up again. It doesn't hold up the TV coming back.

[Unit]
Description=origaiTV check after an update
ConditionPathExists=/var/lib/origaitv/update/check-pending
Wants=origaitv-daemon.service
After=origaitv-daemon.service

[Service]
Type=exec
ExecStart=/usr/bin/origaitv-update-after

[Install]
WantedBy=multi-user.target
