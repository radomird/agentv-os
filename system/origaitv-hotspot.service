# The setup hotspot (ADR-007, stage 4): OrigaiTV's own Wi-Fi network, with
# addresses and names from dnsmasq, for a phone to set up the TV through
# (bin/origaitv-hotspot). origaitv-hotspot-boot.service starts it on first boot
# when there's no network, and so does `origaitv hotspot start`. It closes
# once the box joins the home Wi-Fi or setup ends, and what it opened goes
# with it, however it stops.

[Unit]
Description=OrigaiTV setup hotspot
Requires=NetworkManager.service
After=NetworkManager.service origaitv-daemon.service

[Service]
Type=exec
ExecStart=/usr/bin/origaitv-hotspot run
ExecStopPost=/usr/bin/origaitv-hotspot down
ProtectHome=yes
PrivateTmp=yes
