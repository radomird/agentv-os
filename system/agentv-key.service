# Moves the provider key the daemon was given into /etc/agentv/env, root's
# alone (bin/agentv-key-store). agentv-key.path starts it. systemd makes
# /etc/agentv if it isn't there yet, and lets only this write there. Then
# the router starts again, with the key as it is now.

[Unit]
Description=AgenTV provider key

[Service]
Type=oneshot
ExecStart=/usr/bin/agentv-key-store
ExecStartPost=-/usr/bin/systemctl try-restart agentv-router.service
UMask=0077
ConfigurationDirectory=agentv
ConfigurationDirectoryMode=0755
ProtectSystem=strict
ReadWritePaths=-/var/lib/private/agentv/daemon
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
